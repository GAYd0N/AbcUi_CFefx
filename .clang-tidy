# Advisory baseline. The release does not gate on clang-tidy yet: the legacy
# ABCEnchance-derived files still carry C-style casts and UpperCamelCase API.
# Keep the safe mechanical checks on so new code does not add to the backlog.
Checks: >
  -*,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-use-override,
  modernize-use-emplace,
  modernize-use-default-member-init,
  readability-container-contains,
  performance-*
WarningsAsErrors: ''
FormatStyle: file
