/* popnum.rcss - PopNumberPanel layout, from the old
   abcenchance/res/PopNumber.res (48x64 proportional panel per number, Label
   "PopNumber" same size, textAlignment center, brighttext, scheme Default
   font). One div per number, positioned per-frame in px by PopNumPanel. */

#popnum {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
}

#popnum #numbers {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
}

#popnum .number {
	position: absolute;
	display: block;
	width: 48dp;
	height: 64dp;
	text-align: center;
	/* Old Label vertical centering (vgui) needs the explicit line box. */
	line-height: 64dp;
	/* PopNumber.BackGoundColor = Blank (no background). */
}
