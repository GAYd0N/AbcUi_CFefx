/* serverbrowser.rcss - the find-servers page of the 2026-10-15 redesign.

   Four modules share the main-menu theme tokens (theme.rcss): the view tabs,
   the server table (count bar / sortable header / bounded row window /
   paging), the filter column docked at the right viewport edge, and the
   right-aligned bottom action bar. Read the geometry the same way every
   other page does: absolute dp on the 640x480dp logical screen, scaled by
   the context density ratio (framework::Theme::applyScale). The table
   columns are percentages of the module width so the table fills whatever
   the aspect ratio leaves between the page gutter and the filter column. */

/* Typography note (live-verified 2026-10-15, 1280x800 = 480dp/1.667px per
   dp): text at 8.5dp (a 14.17px font handle) painted every glyph as a filled
   black box on this page, at every colour and every element - measured with
   pixel probes plus an in-game colour experiment. 9dp renders normally, so
   this page stays on the 9dp body tier (the same size the theme's buttons
   use). The pre-existing playerlist 8.5dp rule is outside this page. */

/* ---- page identity ------------------------------------------------------ */

#sb-head {
	position: absolute;
	left: 16dp;
	top: 10dp;
	width: 320dp;
	height: 30dp;
}

#sb-brand {
	display: block;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	margin-bottom: 2dp;
}

#sb-title {
	display: block;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 0.5dp;
	color: var(--abc-text-strong);
}

/* ---- module 1: the view tabs ------------------------------------------- */

#sb-tabs {
	position: absolute;
	left: 16dp;
	top: 46dp;
	width: 600dp;
	height: 22dp;
}

#sb-tabs button {
	display: inline-block;
	min-width: 0dp;
	width: auto;
	height: 22dp;
	line-height: 22dp;
	margin: 0dp 3dp 0dp 0dp;
	padding-left: 11dp;
	padding-right: 11dp;
	background-color: #111920cc;
	border: 1dp var(--abc-line-soft);
	color: var(--abc-text-dim);
	font-size: 9dp;
	letter-spacing: 1dp;
	text-transform: uppercase;
}

#sb-tabs button:hover {
	background-color: var(--abc-surface-3);
	color: var(--abc-text);
}

#sb-tabs button:focus {
	border: 1dp var(--abc-accent);
	color: var(--abc-accent);
}

#sb-tabs button.sb-active {
	background-color: var(--abc-surface-2);
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
	color: var(--abc-text-strong);
	font-weight: bold;
}

/* ---- module 2: the server table ---------------------------------------- */

#sb-list-module {
	position: absolute;
	left: 16dp;
	right: 204dp;
	width: auto;
	top: 74dp;
	height: 356dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
}

/* Count + query status strip: the module's own title bar. */
#sb-module-bar {
	position: absolute;
	left: 0dp;
	right: 0dp;
	width: auto;
	top: 0dp;
	height: 22dp;
	background-color: var(--abc-surface-2);
	border-bottom: 1dp var(--abc-line);
}

#sb-count {
	position: absolute;
	left: 8dp;
	top: 0dp;
	width: 200dp;
	height: 22dp;
	line-height: 22dp;
	font-size: 9dp;
	font-weight: bold;
	letter-spacing: 0.8dp;
	color: var(--abc-accent);
	text-transform: uppercase;
	white-space: nowrap;
	overflow: hidden;
}

#sb-status {
	position: absolute;
	right: 8dp;
	top: 0dp;
	width: 320dp;
	height: 22dp;
	line-height: 22dp;
	text-align: right;
	font-size: 9dp;
	color: var(--abc-text-dim);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The sortable column strip. Cells share the row percentages so the strip
   and the rows stay in one grid. */
#sb-header {
	position: absolute;
	left: 0dp;
	right: 0dp;
	width: auto;
	top: 22dp;
	height: 20dp;
	background-color: #10171c;
	border-bottom: 1dp var(--abc-line);
}

#sb-header .sb-col {
	display: inline-block;
	box-sizing: border-box;
	min-width: 0dp;
	height: 19dp;
	line-height: 19dp;
	margin: 0dp;
	padding: 0dp 4dp 0dp 4dp;
	background-color: transparent;
	border: 0dp;
	vertical-align: top;
	text-align: left;
	font-size: 8dp;
	letter-spacing: 0.6dp;
	text-transform: uppercase;
	color: var(--abc-text-dim);
	white-space: nowrap;
	overflow: hidden;
}

#sb-header button.sb-col:hover {
	background-color: var(--abc-surface-3);
	color: var(--abc-text);
}

#sb-header button.sb-col:focus {
	border: 1dp var(--abc-accent);
	color: var(--abc-accent);
}

#sb-header .sb-sort-asc {
	color: var(--abc-accent);
	font-weight: bold;
}

#sb-header .sb-sort-desc {
	color: var(--abc-warn);
	font-weight: bold;
}

/* The one scrolling region: fixed box, explicit height through the anchors. */
#sb-list {
	position: absolute;
	left: 0dp;
	right: 0dp;
	width: auto;
	top: 42dp;
	bottom: 26dp;
	height: auto;
	overflow: auto;
	background-color: #0c1114;
}

.sb-row {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 22dp;
	line-height: 22dp;
	border-left: 2dp #00000000;
	border-bottom: 1dp var(--abc-line-soft);
	color: var(--abc-text);
	font-size: 9dp;
	tab-index: auto;
	overflow: hidden;
}

.sb-row:nth-child(even) {
	background-color: #0f151a;
}

.sb-row:hover {
	background-color: var(--abc-surface-3);
}

.sb-row:focus {
	border-left: 2dp var(--abc-accent);
}

.sb-row.sb-selected {
	background-color: #1d2830;
	border-left: 2dp var(--abc-accent);
	color: var(--abc-text-strong);
}

.sb-row span {
	display: inline-block;
	box-sizing: border-box;
	height: 21dp;
	line-height: 21dp;
	vertical-align: top;
	padding-right: 6dp;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* One grid for the header strip and every row: VAC | name | map | players |
   bots | ping - the order this page has always displayed its information in
   (the icon column keeps the password lock and the VAC shield). */
.c-vac {
	width: 7%;
}

.c-name {
	width: 38%;
}

.c-map {
	width: 20%;
}

.c-players {
	width: 12%;
}

.c-bots {
	width: 11%;
}

.c-ping {
	width: 12%;
}

.server-icon {
	display: inline-block;
	width: 16dp;
	height: 16dp;
	margin: 3dp 2dp 0dp 4dp;
	vertical-align: top;
}

.m-bots, .m-ping {
	color: var(--abc-text-dim);
}

.m-unknown {
	color: var(--abc-text-dim);
}

.sb-empty, .sb-hint {
	display: block;
	height: 22dp;
	line-height: 22dp;
	padding-left: 8dp;
	font-size: 9dp;
	color: var(--abc-text-dim);
}

#sb-paging {
	position: absolute;
	left: 0dp;
	right: 0dp;
	width: auto;
	bottom: 0dp;
	height: 26dp;
	background-color: var(--abc-surface-2);
	border-top: 1dp var(--abc-line);
}

#sb-paging button {
	display: inline-block;
	min-width: 0dp;
	width: 22dp;
	height: 20dp;
	line-height: 18dp;
	margin: 3dp 4dp 0dp 8dp;
	padding: 0dp;
	font-size: 9dp;
}

#sb-page-next {
	margin-left: 2dp;
}

#sb-page-label {
	display: inline-block;
	height: 20dp;
	line-height: 20dp;
	margin-top: 3dp;
	font-size: 9dp;
	color: var(--abc-text-dim);
}

#sb-paging button.sb-disabled {
	color: var(--abc-text-dim);
	background-color: var(--abc-inset);
	border-color: var(--abc-line);
}

/* The blacklist tab's body replaces the table body 1:1. */
#sb-list-module.sb-blacklist-mode {
	/* The filter column is hidden in this view: the editor takes the whole
	   row instead of leaving the docked column's gutter empty. */
	right: 16dp;
}

#sb-list-module.sb-blacklist-mode #sb-header,
#sb-list-module.sb-blacklist-mode #sb-list,
#sb-list-module.sb-blacklist-mode #sb-paging {
	display: none;
}

#sb-blacklist-panel {
	display: none;
	position: absolute;
	left: 0dp;
	right: 0dp;
	width: auto;
	top: 22dp;
	bottom: 0dp;
	height: auto;
	padding: 10dp;
	box-sizing: border-box;
}

#sb-blacklist-panel.sb-open {
	display: block;
}

#sb-blacklist-hint {
	display: block;
	height: 14dp;
	line-height: 14dp;
	font-size: 9dp;
	color: var(--abc-text-dim);
	margin-bottom: 6dp;
}

/* The address input and the add button share one row (explicitly floated:
   the two inline-blocks otherwise wrapped onto separate lines on the live
   context, which the offline geometry check now pins). */
#sb-blacklist-addrow {
	display: block;
	height: 22dp;
	margin-bottom: 8dp;
}

#sb-blacklist-address {
	display: block;
	float: left;
	box-sizing: border-box;
	width: 240dp;
	height: 20dp;
	line-height: 18dp;
	margin: 0dp;
	padding: 0dp 6dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	border: 1dp var(--abc-line);
	font-size: 9dp;
	tab-index: auto;
}

#sb-blacklist-address:focus {
	border: 1dp var(--abc-accent);
}

#sb-blacklist-address caret {
	background-color: var(--abc-text-strong);
}

#sb-rule-add {
	display: block;
	float: left;
	min-width: 0dp;
	height: 20dp;
	line-height: 18dp;
	margin: 0dp 0dp 0dp 6dp;
	padding: 0dp 10dp;
	font-size: 9dp;
}

#sb-blacklist-rules {
	display: block;
	width: 100%;
	height: 230dp;
	overflow: auto;
}

/* The rules table (the Source dialog's shape): one row per blocked server
   with its name, address and the moment it was blocked. */
#sb-blacklist-head, .sb-blacklist-rule {
	box-sizing: border-box;
	display: block;
	width: 100%;
}

#sb-blacklist-head {
	height: 18dp;
	line-height: 18dp;
	border-bottom: 1dp var(--abc-line);
	margin-bottom: 2dp;
	font-size: 8.5dp;
	color: var(--abc-text-dim);
}

.sb-blacklist-rule {
	height: 24dp;
	line-height: 24dp;
	border-bottom: 1dp var(--abc-line-soft);
	font-size: 9dp;
	color: var(--abc-text);
}

#sb-blacklist-head span, .sb-blacklist-rule span {
	display: inline-block;
	box-sizing: border-box;
	height: 24dp;
	line-height: 24dp;
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	padding-right: 6dp;
}

#sb-blacklist-head .bl-name, .sb-blacklist-rule .bl-name {
	width: 42%;
}

#sb-blacklist-head .bl-ip, .sb-blacklist-rule .bl-ip {
	width: 24%;
}

#sb-blacklist-head .bl-time, .sb-blacklist-rule .bl-time {
	width: 22%;
}

#sb-blacklist-head .bl-action, .sb-blacklist-rule .bl-action {
	width: 12%;
	padding-right: 0dp;
}

.sb-blacklist-rule .bl-action button {
	display: inline-block;
	width: 100%;
	min-width: 0dp;
	height: 20dp;
	line-height: 18dp;
	margin: 2dp 0dp 0dp 0dp;
	padding: 0dp 4dp;
	font-size: 8dp;
}

#sb-blacklist-rules scrollbarvertical {
	width: 0dp;
}

#sb-blacklist-rules scrollbarvertical sliderbar {
	width: 10dp;
	min-height: 24dp;
	margin-left: -10dp;
	background-color: #46525a;
}

/* ---- module 3: the filter column --------------------------------------- */

#sb-filter-module {
	position: absolute;
	right: 16dp;
	width: 178dp;
	top: 74dp;
	height: 356dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
}

#sb-filter-module.sb-hidden {
	display: none;
}

#sb-filter-title {
	position: absolute;
	left: 10dp;
	top: 8dp;
	width: 158dp;
}

#sb-filter-body {
	position: absolute;
	left: 10dp;
	right: 10dp;
	width: auto;
	top: 30dp;
}

.sb-frow {
	display: block;
	height: 26dp;
	width: 100%;
}

.sb-flabel {
	display: inline-block;
	box-sizing: border-box;
	width: 82dp;
	height: 26dp;
	line-height: 26dp;
	vertical-align: top;
	font-size: 9dp;
	color: var(--abc-text);
	overflow: hidden;
	white-space: nowrap;
}

#sb-filter-body input, #sb-filter-body select {
	display: inline-block;
	box-sizing: border-box;
	width: 74dp;
	height: 22dp;
	margin: 2dp 0dp 0dp 0dp;
	padding: 0dp 4dp;
	vertical-align: top;
	font-size: 9dp;
	line-height: 20dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	border: 1dp var(--abc-line);
	tab-index: auto;
}

#sb-filter-body input:focus, #sb-filter-body select:hover {
	border: 1dp var(--abc-accent);
}

#sb-filter-body input caret {
	background-color: var(--abc-text-strong);
}

#sb-filter-body select selectvalue {
	display: block;
	height: 20dp;
	line-height: 20dp;
	margin-right: 16dp;
	padding-left: 3dp;
	white-space: nowrap;
	overflow: hidden;
}

#sb-filter-body select selectarrow {
	width: 16dp;
	height: 20dp;
	background-color: var(--abc-surface-3);
	decorator: image(../../img/select-arrow.png);
}

#sb-filters-reset {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 22dp;
	line-height: 20dp;
	margin: 10dp 0dp 0dp 0dp;
	padding: 0dp;
	font-size: 9dp;
}

/* ---- module 4: the action bar ------------------------------------------ */

#sb-actions {
	position: absolute;
	right: 16dp;
	width: 400dp;
	top: 440dp;
	height: 26dp;
	text-align: right;
}

#sb-actions button {
	display: inline-block;
	min-width: 64dp;
	height: 24dp;
	line-height: 22dp;
	margin: 0dp 0dp 0dp 6dp;
	padding-left: 12dp;
	padding-right: 12dp;
	font-size: 9dp;
}

#sb-connect {
	border: 1dp var(--abc-accent-soft);
	color: var(--abc-accent);
}

#sb-connect:focus {
	color: var(--abc-accent-ink);
}

#sb-actions button.sb-disabled, #sb-actions button.sb-disabled:focus {
	background-color: var(--abc-inset);
	color: var(--abc-text-dim);
	border: 1dp var(--abc-line);
}

/* ---- the server detail window ------------------------------------------ */

#sb-detail-overlay {
	display: none;
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	background-color: #000000bb;
	z-index: 300;
}

#sb-detail-overlay.sb-open {
	display: block;
}

#sb-detail-window {
	position: absolute;
	left: 50%;
	margin-left: -190dp;
	top: 34dp;
	box-sizing: border-box;
	width: 380dp;
	height: 412dp;
	padding: 12dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
}

#sb-detail-title {
	display: block;
	width: 240dp;
	height: 20dp;
	line-height: 20dp;
	font-size: 14dp;
	font-weight: bold;
	color: var(--abc-accent);
	margin-bottom: 6dp;
}

#sb-detail-info {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 134dp;
	margin-bottom: 8dp;
	padding-bottom: 6dp;
	border-bottom: 1dp var(--abc-line-soft);
	overflow: hidden;
}

#sb-detail-name {
	display: block;
	height: 18dp;
	line-height: 18dp;
	font-size: 12dp;
	font-weight: bold;
	color: var(--abc-text-strong);
	margin-bottom: 4dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.sb-detail-line {
	display: block;
	height: 14dp;
	line-height: 14dp;
	font-size: 9dp;
	color: var(--abc-text);
}

.sb-detail-line .k {
	display: inline-block;
	box-sizing: border-box;
	width: 74dp;
	height: 14dp;
	color: var(--abc-text-dim);
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
}

.sb-detail-line .v {
	display: inline-block;
	box-sizing: border-box;
	width: 250dp;
	height: 14dp;
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

#sb-detail-players {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 188dp;
	overflow: auto;
}

/* The window's own buttons, in its bottom row (join first, close last). */
#sb-detail-actions {
	position: absolute;
	left: 12dp;
	right: 12dp;
	width: auto;
	bottom: 10dp;
	height: 24dp;
	text-align: right;
}

#sb-detail-actions button {
	display: inline-block;
	min-width: 72dp;
	height: 22dp;
	line-height: 20dp;
	margin: 0dp 0dp 0dp 8dp;
	padding-left: 12dp;
	padding-right: 12dp;
	font-size: 9dp;
}

#sb-detail-join {
	border: 1dp var(--abc-accent-soft);
	color: var(--abc-accent);
}

#sb-detail-join:focus {
	color: var(--abc-accent-ink);
}

/* 自动重试 (the detail window's toggle): lit while the browser keeps trying
   to join the shown server. */
#sb-auto-retry {
	min-width: 88dp;
}

#sb-auto-retry.sb-toggled {
	border: 1dp var(--abc-accent);
	color: var(--abc-accent);
	background-color: var(--abc-accent-soft);
}

#sb-auto-retry.sb-toggled:focus {
	color: var(--abc-accent-ink);
}

.sb-player-head {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 16dp;
	line-height: 16dp;
	border-bottom: 1dp var(--abc-line);
	margin-bottom: 2dp;
	color: var(--abc-text-dim);
	font-size: 8dp;
}

.sb-player-head span, .sb-player span {
	display: inline-block;
	box-sizing: border-box;
	height: 16dp;
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.sb-player {
	display: block;
	height: 18dp;
	line-height: 18dp;
	font-size: 9dp;
	color: var(--abc-text);
}

.dp-name {
	width: 232dp;
}

.dp-score {
	width: 50dp;
}

.dp-time {
	width: 70dp;
}

/* ---- the row context menu (the secondary menu) ------------------------- */

#sb-context-menu {
	display: none;
	position: absolute;
	width: 132dp;
	padding: 2dp;
	background-color: #10161af8;
	border: 1dp var(--abc-line);
	z-index: 400;
}

#sb-context-menu.sb-open {
	display: block;
}

.sb-menu-entry {
	display: block;
	height: 20dp;
	line-height: 20dp;
	padding-left: 8dp;
	padding-right: 4dp;
	font-size: 9dp;
	color: var(--abc-text);
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	tab-index: auto;
}

.sb-menu-entry:hover, .sb-menu-entry:focus {
	background-color: var(--abc-accent);
	color: var(--abc-accent-ink);
}
