/* T12 display-mode confirmation dialog. Centered box over a dimmed backdrop;
   layers follow the settings.rcss conventions (dp units, explicit colors). */

body#videoconfirm {
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 160);
}

#videoconfirm-box {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
	width: 560dp;
	padding: 28dp 32dp 24dp 32dp;
	background-color: #1b1f24;
	border: 2dp #4a5058;
	border-radius: 6dp;
}

#videoconfirm-title {
	font-size: 26dp;
	color: #ffffff;
	margin: 0 0 12dp 0;
}

#videoconfirm-lead {
	font-size: 17dp;
	color: #c8ccd2;
	margin: 0 0 14dp 0;
}

.videoconfirm-line {
	font-size: 18dp;
	margin: 4dp 0;
}

.videoconfirm-key {
	color: #8f969e;
	margin-right: 10dp;
}

#videoconfirm-actual {
	color: #ffffff;
}

#videoconfirm-requested {
	color: #b7bec6;
}

#videoconfirm-timeout {
	font-size: 16dp;
	color: #d8b45a;
	margin: 14dp 0 0 0;
}

#videoconfirm-actions {
	margin-top: 20dp;
	text-align: right;
}

#videoconfirm-actions button {
	font-size: 18dp;
	min-width: 180dp;
	margin-left: 12dp;
	padding: 6dp 14dp;
	background-color: #2c323a;
	border: 2dp #5a626c;
	border-radius: 4dp;
	color: #ffffff;
}

#videoconfirm-actions button:hover {
	background-color: #39414b;
}

#videoconfirm-actions button:focus {
	border-color: #d8b45a;
}

#videoconfirm-keep.video-disabled {
	color: #6f757c;
	border-color: #3a4047;
}
