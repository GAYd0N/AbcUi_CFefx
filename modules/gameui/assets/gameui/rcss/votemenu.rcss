/* votemenu.rcss - the vote creation page, on the shared menu theme.

   The page deliberately follows Settings' two-column composition: the four
   vote types form a vertical navigation rail on the left, one content panel
   occupies the right, and the actions share a single bottom flex row. All
   units are dp on the 640x480 logical screen; Theme::applyScale handles the
   display scale. */

/* ---- page frame ---------------------------------------------------------- */

#vm-navigation {
	position: absolute;
	left: 16dp;
	top: 40dp;
	width: 128dp;
	height: 356dp;
	overflow: auto;
}

#vm-navigation button {
	display: block;
	box-sizing: border-box;
	width: 122dp;
	height: 28dp;
	line-height: 26dp;
	text-align: left;
	padding-left: 10dp;
	margin: 0dp 0dp 3dp 0dp;
	background-color: #111920cc;
	border-left: 2dp var(--abc-line);
	border-top: 1dp var(--abc-line-soft);
	color: var(--abc-text);
	font-size: 9dp;
	letter-spacing: 0.4dp;
	tab-index: auto;
}

#vm-navigation button:hover {
	background-color: #1b252bf2;
	color: var(--abc-text-strong);
}

#vm-navigation button.vm-active {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent);
}

#vm-navigation button:focus {
	background-color: var(--abc-accent);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent-ink);
}

#vm-panel {
	position: absolute;
	left: 156dp;
	right: 32dp;
	width: auto;
	top: 40dp;
	height: 356dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
}

/* ---- identity head ------------------------------------------------------- */

#vm-head {
	position: absolute;
	left: 14dp;
	right: 14dp;
	width: auto;
	top: 8dp;
	height: 46dp;
}

#vm-brand {
	display: block;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	height: 12dp;
	line-height: 12dp;
}

#vm-title {
	display: inline-block;
	height: 24dp;
	line-height: 24dp;
	font-size: 17dp;
	font-weight: bold;
	color: var(--abc-text-strong);
	letter-spacing: 0.4dp;
}

#vm-subtitle {
	display: inline-block;
	margin-left: 10dp;
	height: 24dp;
	line-height: 24dp;
	font-size: 9dp;
	color: var(--abc-text-dim);
}

/* ---- filter strip ------------------------------------------------------- */

#vm-tools {
	position: absolute;
	left: 14dp;
	right: 14dp;
	width: auto;
	top: 60dp;
	height: 26dp;
}

#vm-filter {
	position: absolute;
	left: 0dp;
	top: 0dp;
	display: inline-block;
	box-sizing: border-box;
	width: 246dp;
	height: 26dp;
	padding: 0dp 7dp;
	font-size: 9dp;
	line-height: 24dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	border: 1dp var(--abc-line);
	tab-index: auto;
	white-space: nowrap;
}

#vm-filter:focus {
	border: 1dp var(--abc-accent);
	background-color: #0e1418;
}

#vm-filter-apply {
	position: absolute;
	left: 254dp;
	top: 0dp;
	width: 78dp;
	height: 26dp;
	line-height: 24dp;
	font-size: 9dp;
	margin: 0dp;
}

#vm-count-wrap {
	position: absolute;
	right: 0dp;
	top: 0dp;
	width: 70dp;
	height: 26dp;
	line-height: 26dp;
	text-align: right;
}

#vm-count-label {
	display: inline;
	font-size: 8dp;
	color: var(--abc-text-dim);
}

#vm-count {
	display: inline;
	margin-left: 4dp;
	font-size: 9dp;
	font-weight: bold;
	color: var(--abc-accent);
}

/* ---- player / map list -------------------------------------------------- */

#vm-list-head {
	position: absolute;
	left: 14dp;
	right: 14dp;
	width: auto;
	top: 90dp;
	height: 20dp;
	line-height: 20dp;
	display: flex;
	background-color: var(--abc-surface-2);
	border-bottom: 1dp var(--abc-line);
	color: var(--abc-text-dim);
	font-size: 8dp;
}

.vm-col {
	display: block;
	box-sizing: border-box;
	height: 20dp;
	line-height: 20dp;
	padding-left: 8dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.vm-col-slot { flex: 0 0 38dp; }
.vm-col-name { flex: 1 1 auto; min-width: 0dp; }
.vm-col-real { flex: 0 0 126dp; }
.vm-col-id { flex: 0 0 150dp; }

#vm-list {
	position: absolute;
	left: 14dp;
	right: 14dp;
	width: auto;
	top: 110dp;
	height: 174dp;
	overflow-y: auto;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line-soft);
	border-top: 0dp;
}

.vm-row {
	display: flex;
	box-sizing: border-box;
	width: 100%;
	height: 26dp;
	line-height: 25dp;
	padding-left: 1dp;
	border-left: 2dp #00000000;
	border-bottom: 1dp var(--abc-line-soft);
	color: var(--abc-text);
	font-size: 9dp;
	tab-index: auto;
	nav: vertical;
	white-space: nowrap;
}

.vm-row:hover {
	background-color: var(--abc-surface-3);
}

.vm-row:focus {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
}

.vm-row.vm-selected {
	background-color: #1d2830;
	border-left: 2dp var(--abc-accent);
	color: var(--abc-text-strong);
}

.vm-slot,
.vm-name,
.vm-real,
.vm-id,
.vm-map-name {
	display: block;
	box-sizing: border-box;
	height: 25dp;
	line-height: 25dp;
	padding-left: 8dp;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.vm-slot {
	flex: 0 0 38dp;
	color: var(--abc-accent);
	font-weight: bold;
}

.vm-name { flex: 1 1 auto; min-width: 0dp; }
.vm-real { flex: 0 0 126dp; color: var(--abc-text-dim); }
.vm-id { flex: 0 0 150dp; color: var(--abc-text-dim); }
.vm-map-name { flex: 1 1 auto; min-width: 0dp; }

.vm-empty {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 84dp;
	line-height: 84dp;
	padding-left: 10dp;
	font-size: 9dp;
	color: var(--abc-text-dim);
}

/* RmlUi builds scrollbar parts explicitly; keep the thin Settings-style bar
   from overlaying the list rows. */
#vm-list scrollbarvertical {
	z-index: 100;
	width: 0dp;
}

#vm-list scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: var(--abc-line);
}

#vm-list scrollbarvertical sliderbar:hover,
#vm-list scrollbarvertical sliderbar:active {
	background-color: #55606c;
}

/* ---- selection and feedback -------------------------------------------- */

#vm-selection-row {
	position: absolute;
	left: 14dp;
	right: 14dp;
	width: auto;
	top: 290dp;
	height: 18dp;
	line-height: 18dp;
	font-size: 9dp;
}

#vm-selection-label {
	display: inline;
	color: var(--abc-text-dim);
	text-transform: uppercase;
	letter-spacing: 0.8dp;
}

#vm-selected {
	display: inline;
	margin-left: 8dp;
	color: var(--abc-accent);
	font-weight: bold;
}

#vm-hint {
	position: absolute;
	left: 14dp;
	right: 14dp;
	top: 308dp;
	width: auto;
	height: 16dp;
	line-height: 16dp;
	font-size: 9dp;
	color: #ff8866;
	display: none;
	margin: 0dp;
}

/* ---- action bar --------------------------------------------------------- */

/* The same bottom gutter as Settings. Flex children fill the row and never
   wrap, which keeps both buttons on one baseline at every width. */
#vm-actions {
	display: flex;
	position: absolute;
	left: 156dp;
	right: 32dp;
	bottom: 48dp;
	width: auto;
	height: 28dp;
}

#vm-actions button {
	display: block;
	box-sizing: border-box;
	flex: 1 1 0%;
	width: auto;
	min-width: 0dp;
	height: 28dp;
	line-height: 26dp;
	margin: 0dp 0dp 0dp 10dp;
	font-size: 9dp;
	white-space: nowrap;
	overflow: hidden;
}

#vm-actions button:first-child {
	margin-left: 0dp;
}

#vm-submit {
	border: 1dp var(--abc-accent-soft);
	color: var(--abc-accent);
}

#vm-submit:focus {
	color: var(--abc-accent-ink);
}

#vm-submit:disabled {
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	color: var(--abc-text-dim);
}
