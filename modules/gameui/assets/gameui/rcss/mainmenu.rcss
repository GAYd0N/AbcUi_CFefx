/* mainmenu.rcss - T05 minimal interactive page. Layout in dp only: the
   context density ratio (framework::Theme::applyScale) does all scaling, so
   no pixel assumptions live here. RmlUi ships no user-agent stylesheet -
   every element gets its full display/tab/caret styling explicitly. */

/* ---- identity block ---------------------------------------------------- */

#menu-header {
	position: absolute;
	left: 26dp;
	top: 20dp;
	width: 300dp;
}

#menu-brand {
	display: block;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	margin-bottom: 2dp;
}

#title {
	display: block;
	font-size: 18dp;
	font-weight: bold;
	letter-spacing: 0.5dp;
	color: var(--abc-text-strong);
}

/* ---- entry column ------------------------------------------------------ */

#menu-nav {
	position: absolute;
	left: 26dp;
	top: 92dp;
	width: 236dp;
}

/* One entry row: a flat, left-aligned bar with an amber spine when focused -
   the GoldSrc list look, flattened for the modern shell. */
#page-main button, #page-pause button {
	display: block;
	width: 236dp;
	height: 26dp;
	line-height: 26dp;
	text-align: left;
	padding-left: 12dp;
	background-color: #111920cc;
	border-left: 2dp #2d3840;
	border-top: 1dp #1e262c;
	color: var(--abc-text);
	font-size: 10dp;
	letter-spacing: 0.4dp;
	tab-index: auto;
	margin-bottom: 4dp;
}

#page-main button:hover, #page-pause button:hover {
	background-color: #1b252bf2;
	color: var(--abc-text-strong);
}

#page-main button:focus, #page-pause button:focus {
	background-color: var(--abc-accent);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent-ink);
	font-weight: bold;
}

#focus-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	height: 12dp;
	line-height: 12dp;
	margin-top: 6dp;
	padding-left: 2dp;
}

/* ---- side column: the character as the subject, the board in the corner -- */
/* The card is anchored with percentages: the Rml logical screen is
   screenWidth / (screenHeight / 480) dp wide (768dp at 16:10, 853dp at 16:9),
   so fixed coordinates would drift with the aspect ratio - the composition
   (card centred between the entry column and the board) has to hold at every
   aspect. The board keeps a fixed right anchor; it is small enough that the
   two only share the corner the card's framing box crosses. */

#player-card {
	position: absolute;
	left: 42%;
	top: 48dp;
	width: 34%;
	height: 396dp;
}

/* The live Studio preview; the Renderer draws it into its own FBO and the
   element presents it, so the box here is exactly what the camera frames. */
#player-model {
	display: block;
	width: 100%;
	height: 100%;
}

/* The friends board is a support surface: compact rows, a bounded list, and
   the local player's own row (row 0) kept as the board's subject - the
   reference's leader row reads larger than the names under it. */
#friends-panel {
	position: absolute;
	right: 26dp;
	top: 92dp;
	width: 190dp;
	max-height: 118dp;
	padding: 7dp;
	overflow: hidden;
}

/* Four rows fit the 96dp box (the self row 32+1, three friend rows 20+1);
   the rest scrolls under the board's own scrollbar. */
#friends-list {
	display: block;
	max-height: 96dp;
	overflow-y: auto;
}

/* Friend rows: avatar, persona, state; right-click opens the join menu. */
.friend-row {
	position: relative;
	display: block;
	height: 20dp;
	line-height: 20dp;
	border-bottom: 1dp var(--abc-line-soft);
	background-color: transparent;
	color: var(--abc-text);
	font-size: 7dp;
	padding-left: 4dp;
	padding-right: 5dp;
}

.friend-row:hover {
	background-color: var(--abc-surface-3);
}

/* The local player: one row taller than a friend row, a bigger avatar and
   the board's only bold name. */
.friend-row.friend-self {
	height: 32dp;
	line-height: 32dp;
	font-size: 10dp;
	font-weight: bold;
	color: var(--abc-accent);
}

.friend-row.friend-playing {
	color: var(--abc-ok);
}

.friend-avatar {
	display: inline-block;
	width: 13dp;
	height: 13dp;
	margin-right: 5dp;
	margin-top: 3dp;
	vertical-align: top;
}

.friend-row.friend-self .friend-avatar {
	width: 22dp;
	height: 22dp;
	margin-right: 6dp;
	margin-top: 5dp;
}

.friend-name {
	display: inline-block;
	height: 18dp;
	line-height: 18dp;
	font-size: 7dp;
	width: 104dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.friend-row.friend-self .friend-name {
	height: 30dp;
	line-height: 30dp;
	font-size: 10dp;
	width: 118dp;
}

.friend-state {
	position: absolute;
	right: 2dp;
	top: 0dp;
	display: inline-block;
	height: 18dp;
	line-height: 18dp;
	font-size: 6.5dp;
	float: right;
	color: var(--abc-text-dim);
}

.friend-row.friend-self .friend-state {
	height: 30dp;
	line-height: 30dp;
	font-size: 8dp;
	color: var(--abc-accent);
}

#friends-empty {
	display: block;
	height: 96dp;
	line-height: 96dp;
	text-align: center;
	font-size: 8dp;
	color: var(--abc-text-dim);
}

/* Right-click menu for a friend row. */
#friend-menu {
	display: none;
	position: absolute;
	width: 116dp;
	background-color: #10161af8;
	border: 1dp var(--abc-line);
	padding: 2dp;
}

.friend-menu-entry {
	display: block;
	height: 20dp;
	line-height: 20dp;
	font-size: 8dp;
	padding-left: 6dp;
	color: var(--abc-text);
}

.friend-menu-entry:hover {
	background-color: var(--abc-accent);
	color: var(--abc-accent-ink);
}

#player-strip {
	display: block;
	width: 258dp;
	height: 40dp;
	background-color: var(--abc-surface);
	border-top: 1dp var(--abc-line);
	border-left: 2dp var(--abc-accent);
	padding-left: 8dp;
	padding-top: 3dp;
}

#player-name {
	display: block;
	height: 16dp;
	line-height: 16dp;
	font-size: 10dp;
	font-weight: bold;
	color: var(--abc-text-strong);
	white-space: nowrap;
}

#player-model-row {
	display: block;
	height: 14dp;
	line-height: 14dp;
	font-size: 8dp;
}

#player-model-label {
	display: inline-block;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: var(--abc-text-dim);
	margin-right: 6dp;
}

#player-model-name {
	display: inline-block;
	color: var(--abc-accent);
}

/* ---- footer ------------------------------------------------------------ */

#menu-footer {
	position: absolute;
	left: 26dp;
	right: 26dp;
	top: 452dp;
	width: auto;
	height: 14dp;
}

#menu-hint {
	display: inline-block;
	font-size: 8dp;
	height: 14dp;
	line-height: 14dp;
}

#menu-version {
	display: inline-block;
	float: right;
	font-size: 8dp;
	height: 14dp;
	line-height: 14dp;
}

/* Inputs share one rule; the multiline box adds rows and line breaks. */
#text-field, #password-field, #area-field {
	display: inline-block;
	box-sizing: border-box;
	width: 100%;
	height: 24dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
	white-space: nowrap;
	margin-bottom: 8dp;
}

#area-field {
	height: 56dp;
	line-height: 16dp;
	white-space: normal;
	overflow: hidden;
}

#text-field:focus, #password-field:focus, #area-field:focus {
	border: 1dp var(--abc-accent);
	background-color: #0e1418;
}

#text-field caret, #password-field caret, #area-field caret {
	display: inline-block;
	background-color: #e8e8e8;
}

/* T09 shell: the two home sections of the state machine. Only one section
   is ever visible (the module's sync decides); pause starts hidden so the
   shipped document boots on the no-map home. */
#page-main {
	display: block;
}

#page-pause {
	display: none;
}

/* Shared panel text of the stub/confirm windows (mainmenu.rml keeps its own
   ids; these are the element defaults the two windows rely on). */
p {
	display: block;
	font-size: 10dp;
	color: var(--abc-text);
	margin-bottom: 12dp;
}

#confirm-actions {
	display: block;
}

#confirm-actions button {
	display: inline-block;
	width: auto;
	/* The shared prompt's button spacing; size, surface and focus fill come
	   from the theme's button rule. */
	margin: 0dp 0dp 0dp 8dp;
}
#confirm-actions button:first-child { margin-left: 0dp; }

/* Modal confirmation is centered over a scrim. This is the prompt the
   settings page mirrors: the surface, 372dp content box, hairline border
   with the amber top rule, padding and headline all come from the shared
   #panel frame and the title rule here. The centered-with-5dp-lift anchor
   matches the settings prompt (the 50vh rows plus the auto margins centre
   the box whatever its height, the transform lifts it 5dp). The safe
   cancel button keeps the keyboard focus. */
body#menuconfirm { background-color: #00000088; }
body#menuconfirm #panel {
	left: 50vw;
	top: 50vh;
	bottom: 50vh;
	margin-left: -186dp; /* half of the 372dp box */
	margin-top: auto;
	margin-bottom: auto;
	transform: translateY(-5dp);
	min-height: 128dp;
	padding: 20dp;
}
#confirm-title {
	font-size: 16dp;
	color: var(--abc-accent);
	margin-bottom: 12dp;
}
