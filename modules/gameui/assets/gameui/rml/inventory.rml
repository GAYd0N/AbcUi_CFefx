<rml>
<head>
	<link type="text/rcss" href="mod://abcui.base/rcss/base.rcss"/>
	<link type="text/rcss" href="mod://abcui.base/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/inventory.rcss"/>
</head>
<!-- Inventory window: the RmlUi replacement for the client's VGUI
     CInventoryPanel (issue 10). The chained inventory/+inventory/-inventory
     commands suppress the native window; the page is projected from
     services::inventory::InventoryModel, which mirrors the InvAdd/InvRemove
     usermsg stream.

     Layout: a dimmed scrim keeps the game readable but out of the way, a
     520x360dp window carries the title bar, the item list on the left, the
     selected item's detail card on the right, and the action row at the
     bottom. No full-window menu backdrop: the world stays visible through
     the scrim. -->
<body id="menuinventory">
	<!-- Clicking the scrim is the same dismiss gesture as the close button. -->
	<div id="inv-scrim" data-action="inv-close"></div>

	<div id="inv-window">
		<!-- Dedicated fill layer: child fills are the path the render bridge
		     paints correctly (the window's own background is kept transparent). -->
		<div id="inv-window-bg"></div>
		<div id="inv-header">
			<div id="inv-eyebrow">Sven Co-op</div>
			<div id="inv-title">#abcui.gameui/Invmenu_Topcaption</div>
			<button id="inv-close" data-action="inv-close">×</button>
		</div>

		<div id="inv-list-panel">
			<div id="inv-list-head">
				<span id="inv-list-label">#abcui.gameui/Invmenu_ListHead</span>
				<span id="inv-count">0</span>
			</div>
			<div id="inv-list-wrap">
				<div id="inv-list" tab-index="auto"></div>
				<div id="inv-empty">
					<div id="inv-empty-title">#abcui.gameui/Invmenu_NoInventory</div>
					<div id="inv-empty-hint">#abcui.gameui/Invmenu_EmptyHint</div>
				</div>
			</div>
		</div>

		<div id="inv-detail-panel">
			<div id="inv-detail-head">#abcui.gameui/Invmenu_Details</div>
			<div id="inv-detail-body">
				<div id="inv-name">#abcui.gameui/Invmenu_NoItemSelected</div>
				<div id="inv-detail-rule"></div>
				<div id="inv-desc">#abcui.gameui/Invmenu_NoItemSelected</div>
			</div>
			<div id="inv-tags">
				<span id="inv-tag-usable" class="inv-tag">#abcui.gameui/Invmenu_Usable</span>
				<span id="inv-tag-droppable"
					class="inv-tag">#abcui.gameui/Invmenu_Droppable</span>
			</div>
			<div id="inv-select-hint">#abcui.gameui/Invmenu_SelectHint</div>
		</div>

		<div id="inv-footer-rule"></div>

		<!-- Native verb order is Drop / Activate / Drop ALL; the redesign keeps
		     the destructive verb alone on the left and the two item verbs on
		     the right, where the primary action is easiest to reach. -->
		<div id="inv-actions">
			<button id="inv-dropall" class="inv-ghost-danger"
				data-action="inv-dropall">#abcui.gameui/Invmenu_DropAll</button>
			<button id="inv-drop" class="inv-secondary"
				data-action="inv-drop">#abcui.gameui/Invmenu_Drop</button>
			<button id="inv-activate" class="inv-primary"
				data-action="inv-activate">#abcui.gameui/Invmenu_Activate</button>
		</div>
	</div>
</body>
</rml>
