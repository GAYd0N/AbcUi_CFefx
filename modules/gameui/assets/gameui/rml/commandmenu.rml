<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/commandmenu.rcss"/>
</head>
<!-- In-game command menu: the RmlUi replacement for +commandmenu.

     The columns are rebuilt from commandmenu.json. Only three consecutive
     levels are visible at once; deeper levels slide the stack left. The
     document deliberately has no backdrop element so the live game frame
     remains visible through the semi-transparent column surfaces. -->
<body id="menucommandmenu">
	<div id="cm-shell">
		<div id="cm-head">
			<span id="cm-title">#CommandMenu_Title</span>
		</div>
		<div id="cm-columns"></div>
	</div>
</body>
</rml>
