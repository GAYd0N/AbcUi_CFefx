<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/console.rcss"/>
</head>
<!-- T16 replacement console (menuconsole overlay): the bounded engine
     output mirror (rendered as plain text, one .console-line row per line),
     the completion list, the multi-line paste confirmation pane, and the
     single-line command editor. The module owns visibility; the page owns
     the projection and the input loop. All dynamic text is escaped by
     panels::console::ConsolePage before it reaches the DOM. -->
<body id="menuconsole">
	<div id="console-box">
		<div id="console-header">
			<span id="console-title">#Console_Title</span>
			<span id="console-count"></span>
			<button id="console-close" data-action="console-close" data-label="#Console_Close">#Console_Close</button>
		</div>
		<div id="console-history"></div>
		<!-- Selection is painted over the rows by the page: translucent
		     rectangles, no hit testing, clipped to the history viewport. -->
		<div id="console-selection"></div>
		<div id="console-suggestions"></div>
		<div id="console-confirm">
			<p id="console-confirm-lead"></p>
			<div id="console-confirm-text"></div>
			<div id="console-confirm-actions">
				<button id="console-confirm-yes" data-action="console-confirm-yes" data-label="#Console_ConfirmYes">#Console_ConfirmYes</button>
				<button id="console-confirm-no" data-action="console-confirm-no" data-label="#Console_ConfirmNo">#Console_ConfirmNo</button>
			</div>
		</div>
		<div id="console-input-row">
			<span id="console-prompt">]</span>
			<input id="console-input" type="text" autofocus="autofocus"/>
		</div>
		<!-- Output context menu: shown at the pointer by the page. -->
		<div id="console-context-menu">
			<div id="console-context-copy" class="console-context-item" data-action="console-context-copy">#Console_Copy</div>
		</div>
	</div>
</body>
</rml>
