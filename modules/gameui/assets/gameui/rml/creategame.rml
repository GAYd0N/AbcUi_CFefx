<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/creategame.rcss"/>
	<link type="text/rcss" href="../rcss/range.rcss"/>
</head>
<!-- T19 create-local-game page (kCreateGame), on the shared menu theme and
     with the full-page frame the settings / find-servers pages use: an
     identity head, the map picker module on the left (search field + the
     filtered map list) and the server-settings module on the right (the
     shipped CreateMultiplayerGameServerPage entries - players / name /
     password - plus the LAN toggle and the numeric server options), then the
     hint line and the action bar along the bottom.

     The map list rows are injected by panels::creategame::CreateGamePage from
     services::creategame::MapCatalog. #cg-map is the list's value store: the
     page keeps it filled with one option per filtered map and reads the
     selection back through selectedMap(); it stays out of the paint (the
     visible picker is the row list) but keeps the catalog contract and the
     form-control read-back in one place. Every dynamic string is injected
     escaped - none of it is markup. -->
<body id="menucreategame">
	<div id="cg-panel">
		<div id="cg-head">
			<div id="cg-brand">Sven Co-op</div>
			<h1 id="cg-title">#CG_Title</h1>
		</div>

		<!-- Module 1: the map picker. The bar carries the module title and the
		     filtered/total count; the search field narrows the list live. -->
		<div id="cg-map-module">
			<div id="cg-map-bar">
				<div id="cg-map-caption" class="abc-sectitle">#CG_Map</div>
				<div id="cg-map-count"></div>
			</div>
			<div class="cg-row" id="cg-map-search">
				<div class="cg-row-label">#CG_MapSearch</div>
				<input id="cg-map-filter" type="text" maxlength="64"
					data-label="#CG_MapSearch" autofocus="autofocus"/>
			</div>
			<div id="cg-map-list"></div>
			<select id="cg-map"></select>
		</div>

		<!-- Module 2: the server settings. Rows mirror the shipped
		     CreateMultiplayerGameServerPage entries; #cg-options takes the
		     numeric server options (services::creategame::ServerOptions). -->
		<div id="cg-form-module">
			<div id="cg-form-bar">
				<div id="cg-form-caption" class="abc-sectitle">#CG_Settings</div>
			</div>
			<div id="cg-form-body">
				<div class="cg-row">
					<div class="cg-row-label">#CG_Players</div>
					<input id="cg-players" class="cg-slider" type="range" min="1" max="32" step="1"
						data-label="#CG_Players"/>
					<span id="cg-players-value" class="row-value">8</span>
				</div>
				<div class="cg-row">
					<div class="cg-row-label">#CG_Name</div>
					<input id="cg-name" type="text" data-label="#CG_Name"/>
				</div>
				<div class="cg-row">
					<div class="cg-row-label">#CG_Password</div>
					<input id="cg-password" type="password" data-label="#CG_Password"/>
				</div>
				<div class="cg-row">
					<div class="cg-row-label">#CG_Lan</div>
					<button id="cg-lan" data-action="cg-lan" data-label="#CG_Lan">#Settings_Off</button>
				</div>
				<div id="cg-options"></div>
			</div>
		</div>

		<p id="cg-hint"></p>
		<div id="cg-actions">
			<button id="cg-apply" data-action="cg-apply" data-label="#CG_Apply">#CG_Apply</button>
			<button id="cg-cancel" data-action="cg-cancel" data-label="#MainMenu_Return">#MainMenu_Return</button>
		</div>
	</div>
</body>
</rml>
