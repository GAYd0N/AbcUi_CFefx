<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/playerlist.rcss"/>
</head>
<!-- T20 player list (kPlayerList): the replacement of the shipped
     Resource/PlayerListDialog.res (ListPanel + Mute button + Close). Rows,
     selection highlight, mute label and the empty state are injected by the
     abcui.gameui module (escaped); the mute control reports a fixed toggle
     intent and is disabled exactly when the shipped button was (no backend /
     nothing mutable selected). -->
<body id="menuplayerlist">
	<div id="pl-panel">
		<h1 id="pl-title">#PL_Title</h1>
		<div id="pl-list"></div>
		<p id="pl-status"></p>
		<div id="pl-actions">
			<button id="pl-mute" data-action="pl-mute" data-label="#PL_Mute"><span id="pl-mute-label">#PL_Mute</span></button>
			<button id="pl-close" data-action="pl-close" data-label="#MainMenu_Return">#MainMenu_Return</button>
		</div>
	</div>
</body>
</rml>
