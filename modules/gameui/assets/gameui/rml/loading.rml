<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/loading.rcss"/>
</head>
<!-- T14 loading page (kLoading): the connect attempt's progress lives here.
     Primary/secondary channels follow the engine stream; both stay hidden
     until the engine drives them (unknown totals never fake a fill). All
     dynamic text is injected escaped by panels::loading::LoadingPage. -->
<body id="menuloading">
	<div id="loading-box">
		<h1 id="loading-title">#Loading_Title</h1>
		<p id="loading-target" class="loading-sub"></p>
		<p id="loading-status"></p>
		<progress id="loading-progress" max="1" value="0"/>
		<p id="loading-progress-text" class="loading-sub"></p>
		<progress id="loading-secondary" max="1" value="0"/>
		<p id="loading-secondary-text" class="loading-sub"></p>
		<p id="loading-resource" class="loading-sub"></p>
		<div id="loading-actions">
			<button id="loading-cancel" data-action="loading-cancel" data-label="#Loading_Cancel">#Loading_Cancel</button>
		</div>
	</div>
</body>
</rml>
