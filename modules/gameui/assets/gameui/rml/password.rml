<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="engine://abc/abcui/rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/loading.rcss"/>
</head>
<!-- T14 password overlay (kPassword): the attempt waits while the player
     types the server password. The value only ever travels into the
     submitPassword backend call - never stored, never logged. -->
<body id="menupassword">
	<div id="password-box">
		<h1 id="password-title">#Loading_PasswordTitle</h1>
		<p id="password-lead">#Loading_PasswordRequired</p>
		<input id="password-field" type="password" autofocus="autofocus" data-label="#Loading_PasswordField"/>
		<p id="password-hint" class="loading-sub"></p>
		<div id="password-actions">
			<button id="password-connect" data-action="password-connect" data-label="#Loading_Connect">#Loading_Connect</button>
			<button id="password-cancel" data-action="password-cancel" data-label="#Loading_Cancel">#Loading_Cancel</button>
		</div>
	</div>
</body>
</rml>
