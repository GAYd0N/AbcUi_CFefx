<rml>
<head>
	<link type="text/rcss" href="engine://abc/abcui/rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/itemhighlight.rcss"/>
</head>
<body id="itemhighlight">
	<!-- D-19: the highlight is pure HUD elements. #markers holds one
	     dynamically created marker div per tracked world item (corner-bracket
	     icon + tinted name, old CItemNamePanel); #pickup is the centered
	     pickup prompt (old CItemPickupPanel, soft plate stands in for the
	     vgui GaussianBlurPanel - see the rcss note). -->
	<div id="markers"></div>
	<div id="pickup">
		<img id="pickup-blur" src="mod://abcui.itemhighlight/hud/img/itemhighlight/pickup_blur.png"/>
		<div id="pickup-text"></div>
	</div>
</body>
</rml>
