<rml>
<head>
	<link type="text/rcss" href="mod://abcui.base/rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/chat.rcss"/>
</head>
<!-- Chat (issue 13): the player log grows upward from the message-mode input
     line - newest line closest to where the player is typing. Rows are
     created by panels::ChatPanel (escaped text + per-player name tint), so
     nothing but the two shells lives here. The document starts hidden and
     pointer-transparent like every other HUD panel; the input is
     keyboard-only, exactly like the native one. -->
<body id="chat">
	<div id="chat-log"></div>
	<div id="chat-input-row">
		<span id="chat-prompt">#abcui.chat/Chat_Say</span>
		<input id="chat-input" type="text" maxlength="127"/>
		<!-- Input-method badge (CN/JP/KR...), empty while no IME is active. -->
		<span id="chat-ime"></span>
	</div>
</body>
</rml>
