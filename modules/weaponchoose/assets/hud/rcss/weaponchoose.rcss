/* weaponchoose.rcss - WeaponChoosePanel layout (WeaponChoosePanel.res:
   panel 20,20; slot icons 15x15; active items 60x20, inactive 20x20, 1dp
   gaps; scheme WeaponChoose.*: item art tinted by ammo state, bucket frame
   255 255 0 255). */

#weaponchoose {
	position: absolute;
	left: 0;
	top: 0;
	width: 0;
	height: 0;
	overflow: visible;
}

#box {
	position: absolute;
	left: 20dp;
	top: 20dp;
}

#content {
	position: relative;
	width: 300dp;
	height: 200dp;
}

#content .slot {
	position: absolute;
	width: 15dp;
	height: 15dp;
}

#content .slot img {
	width: 15dp;
	height: 15dp;
}

#content .item {
	position: absolute;
	/* items carry inline left/top/width/height */
}

/* The highlighted item: same geometry, lifted over its slot neighbours so
   the expanded art and the bucket frame are never clipped by them. */
#content .item.active {
	z-index: 1;
}

#content .item img {
	width: 100%;
	height: 100%;
}

/* Old CWeaponChooseItem ammo bars (PerformLayout): 80,80,80,125 backing,
   255,255,0,125 fill (empty = Red) - geometry is inline. */
#content .item .bar-bg {
	position: absolute;
	background-color: rgba(80, 80, 80, 125);
}

#content .item .bar-fill {
	position: absolute;
}

#bucket {
	position: absolute;
	z-index: 2;
}
