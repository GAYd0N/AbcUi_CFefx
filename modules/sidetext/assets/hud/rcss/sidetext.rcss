/* sidetext.rcss - SidePanel layout. Rebuilt from the old
   abcenchance/res/SideTextPanel.res 72x24 pill (ecco bg) into the HL2 readout
   language: the value alone, drawn straight on the scene with no plate, no
   money prefix and no icon. The panel keeps the old anchors - the readout
   still sits a little above the vertical centre on the left edge. */

#sidetext {
	position: absolute;
	left: 16dp;
	top: 50%;
	margin-top: -64dp;
}

/* Value template ({SCORE}/{SPEED}/{MAXSPEED}) at the small side-readout size;
   the panel writes it as additive glyph ink (module-generated textures), so the font
   below only drives the em sizing and the text fallback. */
#sidetext #message {
	font-family: Verdana;
	font-weight: bold;
	font-size: 14dp;
	line-height: 18dp;
	letter-spacing: 0.2dp;
	white-space: nowrap;
	color: var(--abc-hud-accent);
	opacity: var(--abc-hud-value-opacity);
}
