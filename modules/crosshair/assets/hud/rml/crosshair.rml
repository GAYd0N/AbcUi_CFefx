<rml>
<head>
	<link type="text/rcss" href="mod://abcui.base/rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/crosshair.rcss"/>
</head>
<body id="crosshair">
	<!-- Old CCrosshairPanel: 5 outline panels + 5 core panels, geometry in
	     raw pixels driven from CrosshairPanel::onData. -->
	<div id="outline-center" class="outline"></div>
	<div id="outline-top" class="outline"></div>
	<div id="outline-bottom" class="outline"></div>
	<div id="outline-left" class="outline"></div>
	<div id="outline-right" class="outline"></div>
	<div id="core-center" class="core"></div>
	<div id="core-top" class="core"></div>
	<div id="core-bottom" class="core"></div>
	<div id="core-left" class="core"></div>
	<div id="core-right" class="core"></div>
	<img id="spr-crosshair"/>
</body>
</rml>
