/* stacks.rcss - the three pickup stack panels. Anchors from the old
   abcenchance/res/{Ammo,Item,Weapon}StackPanel.res: c<offset> anchors become
   50% + margin; r120/r340 (right/bottom-relative) becomes right/bottom.
   Items stack bottom-up (old PerformLayout): the newest item sits on the
   bottom edge and pushes the older ones up. Reproduced with a plain
   column flow + flex-end packing - note that column-reverse would put the
   FIRST appended child on the bottom edge instead (verified against
   RmlUi 6.3 FlexFormattingContext: reverse axes only flip the cursor
   direction, the DOM order still runs main-start -> main-end). */

#ammostack, #itemstack, #weaponstack {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

#ammostack #stack, #itemstack #stack, #weaponstack #stack {
	position: absolute;
	display: flex;
	flex-flow: column;
	justify-content: flex-end;
	overflow: hidden;
}

/* AmmoStackPanel.res: xpos c45 ypos c-128, 80x200. */
#ammostack #stack {
	left: 50%;
	top: 50%;
	width: 80dp;
	height: 200dp;
	margin-left: 45dp;
	margin-top: -128dp;
}
/* ItemStackPanel.res: xpos c-95 ypos c-128, 30x195. */
#itemstack #stack {
	left: 50%;
	top: 50%;
	width: 30dp;
	height: 195dp;
	margin-left: -95dp;
	margin-top: -128dp;
}
/* WeaponStackPanel.res: xpos r120 ypos r340, 120x280. The vgui "r" anchor
   offsets the panel's LEFT/TOP edge from the screen right/bottom
   (x = screenW - 120dp), so the 120-wide panel sits flush against the
   right edge; bottom = 340 - 280 = 60dp above the screen bottom. */
#weaponstack #stack {
	right: 0dp;
	bottom: 60dp;
	width: 120dp;
	height: 280dp;
}

/* AmmoStack: item 80x20, gap 1; icon box 25% wide, count text after it
   (old CAmmoStackItem::PerformLayout). */
#ammostack .item {
	position: relative;
	flex: none;
	width: 80dp;
	height: 20dp;
	margin-bottom: 1dp;
}
#ammostack .icon {
	position: absolute;
	left: 0dp;
	top: 0dp;
	/* Old CAmmoStackItem::PerformLayout: img = min(w * 0.25, h) = 20, and
	   ImageSprPanel was sized img x img - a SQUARE icon box. 20x10 squashed
	   the square HUD sprite (e.g. the 24x24 ammo crops) by half. */
	width: 20dp;
	height: 20dp;
	/* Old AmmoStack.IconColor = scheme Default (additive tint). */
	image-color: var(--abc-hud-accent);
}
#ammostack .count {
	position: absolute;
	left: 20dp;
	top: 0dp;
	width: 60dp;
	height: 20dp;
	/* Old vgui Label a_west: left aligned, vertically centered in the
	   20-tall item box (the icon is 20 tall too, so both share one line). */
	line-height: 20dp;
	white-space: nowrap;
	color: var(--abc-hud-accent);
}

/* ItemStack: item 30x30, gap 1, icon only. */
#itemstack .item {
	position: relative;
	flex: none;
	width: 30dp;
	height: 30dp;
	margin-bottom: 1dp;
}
#itemstack .icon {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 30dp;
	height: 30dp;
	/* Old ItemStack.IconColor = scheme Default. */
	image-color: var(--abc-hud-accent);
}

/* WeaponStack: item 120x30, gap 2, weapon sprite; empty tint via .empty
   (old WeaponStack.IconEmptyColor = Red). */
#weaponstack .item {
	position: relative;
	flex: none;
	width: 120dp;
	height: 30dp;
	margin-bottom: 2dp;
}
#weaponstack .icon {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 120dp;
	height: 30dp;
	/* Old WeaponStack.IconColor = scheme Default. */
	image-color: var(--abc-hud-accent);
}
#weaponstack .item.empty .icon {
	image-color: #ff0000;
}
