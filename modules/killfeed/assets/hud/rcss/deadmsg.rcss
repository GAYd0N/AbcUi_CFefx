/* deadmsg.rcss - DeathMsgPanel layout, from the old
   abcenchance/res/DeathMsgPanel.res (rs1.1 anchor = right inset 20dp,
   ypos 30, 200 wide, 60 tall). Newest row at the bottom (old
   reverse-iterate PerformLayout bottom-anchored the rows inside the
   60dp-tall box); each row: attacker | [inflictor] | victim, right-packed.
   Colours are the old scheme DeathMsgPanel.* values.
   Note: the old code sized box/rows in proportional units (60u box, row
   height = box/count); the Rml rows are content-sized, so a full 6-row
   feed clips the oldest row's top few dp against the 60dp box - rows
   fade out long before the feed regularly fills that deep. */

#deadmsg {
	position: absolute;
	right: 20dp;
	top: 30dp;
	width: 200dp;
	height: 60dp;
	overflow: hidden;
}

#deadmsg #feed {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 200dp;
	height: 100%;
	display: flex;
	flex-flow: column;
	justify-content: flex-end;
}

#deadmsg .row {
	position: relative;
	flex: none;
	/* Old CDeathMsgItem::PerformLayout sized the row's background to the
	   three labels' content width and right-packed it inside the 200dp
	   panel - a short kill feed row must not paint a full-width box. */
	align-self: flex-end;
	width: auto;
	display: flex;
	flex-flow: row;
	justify-content: flex-end;
	background-color: #7d7d7d7d;
	border-radius: 4dp;
	padding: 1dp 2dp;
	margin-bottom: 1dp;
}

#deadmsg .attacker {
	color: #ff0000;
}
#deadmsg .inflictor {
	color: #ffffff;
	margin: 0dp 1dp;
}
#deadmsg .victim {
	color: #64c882;
}
