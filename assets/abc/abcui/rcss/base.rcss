/* base.rcss - shared HUD theme (fonts, colours, vars). Plan 05 §4.3.
   hud_size / hud_alpha knobs land with batch A; Phase 3 pins the baseline.
   Font faces are loaded natively from C:\Windows\Fonts by rmlui/RmlUiModule
   (Rml::LoadFontFace), so no @font-face rules here - "local()" sources would
   go through the file interface and fail.

   Colour source of truth: the old ABCEnchance scheme (abcenchance/res/
   SchemeBase.res) for the semantic colours, with the HUD accent retuned from
   that scheme's green "Default" to the Half-Life amber - the old palette's
   own "Orange" (255 176 0), the same amber family the menu surfaces use in
   theme.rcss. Byte values:
     HUD accent (was Default green) 255 176 0 255 -> #ffb000
     HUD accent dim (was DefaultTransparent)      -> #ffb0007d
     Red (danger/empty)     255 0 0 255     -> #ff0000
     HealthBar/ArmorBar bg   255 255 255 125 -> #ffffff7d
     TextMenu bg             0 0 0 64       -> #00000040
     TextMenu text           222 222 222 222 -> #dededede
     DeathMsg item bg        125 125 125 125 -> #7d7d7d7d
     DeathMsg attacker       255 0 0 255     -> #ff0000
     DeathMsg inflictor      255 255 255 255 -> #ffffff
     DeathMsg victim         100 200 130 255 -> #64c882
     Slash (ammo bar)        255 0 0 255     -> #ff0000

   Layout units: dp everywhere - the context density ratio is screenH/480
   (framework::Theme::applyScale), so 1dp equals one old proportional unit.
   Font sizes are the old scheme's 1080p tier expressed in dp (they scale
   proportionally like the layout did). */

/* RmlUi 6.3 grammar: font-family takes ONE family name (no CSS comma
   lists - syntax error); CJK coverage comes from the fallback-flagged
   faces loaded in RmlUiModule (per-glyph fallback across those). */
body {
	font-family: Verdana;
	font-size: 8.9dp;
	color: #e8e8e8;

	/* HUD palette tokens. RmlUi 6.3 resolves var() per property
	   (ElementStyle::ResolveVariables), so every HUD sheet references these
	   instead of repeating the literals; changing the accent here retunes the
	   whole HUD. */
	--abc-hud-accent: #ffb000;
	--abc-hud-accent-dim: #ffb0007d;
	--abc-hud-accent-faint: #ffb0004d;
	/* Reserve-ammo ink: the accent at 90%, i.e. only a step below the clip
	   value. The shared dim (49%) made the small 13dp reserve unreadable. */
	--abc-hud-accent-reserve: #ffb000e6;
	--abc-hud-danger: #ff0000;
	/* Meter well behind an additive fill. */
	--abc-hud-track: #000000a0;
	/* Readout brightness. Values and meters are type / flat fills again, so
	   they sit at the opaque-readout levels; the icons stay additive and keep
	   the softer factor they got in the additive pass. Opacity is an inherited
	   RmlUi property applied per element, so a panel can soften one part
	   without fading the rest. */
	--abc-hud-value-opacity: 0.88;
	--abc-hud-icon-opacity: 0.53;
	--abc-hud-meter-opacity: 0.75;
	/* Flashlight readout brightness: FlashlightPanel overrides this on the
	   document (0.75 lit / 0.53 off) and the whole readout - glyph ink, text
	   fallback and lamp art - follows it. */
	--abc-hud-flashlight-opacity: 0.75;
}

/* Additive HUD ink (framework::glyphs): one glyph is a two-layer stack - a
   black silhouette (tex://, source-over) under the additive core (texadd://,
   added to the scene). Black adds nothing in the additive pass, so the
   outline has to be its own straight-alpha layer; that pairing is what keeps
   the glow readable without a plate.
   The glyph cell is 82x128 source with the ink 96 tall on the baseline at
   y=104, so the stack is 0.6833em wide and 1.0667em tall at 0.80em ink, and
   the cell bottom sits 0.2em below the ink baseline (margin-bottom). Sizing
   is in em, so the ink follows the surrounding type; the tint defaults to the
   HUD accent and the danger rule overrides it inline. */
.hud-glyph {
	display: inline-block;
	position: relative;
	width: 0.6833em;
	height: 1.0667em;
	margin-bottom: -0.2em;
}

.hud-glyph img {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* The outline stays opaque black (it must not dim with the readout), the ink
   carries the value opacity. */
.hud-glyph .glyph-outline {
	opacity: 1;
}

.hud-glyph .glyph-ink {
	opacity: var(--abc-hud-value-opacity);
}

.hud-meter {
	image-color: var(--abc-hud-accent);
	opacity: var(--abc-hud-meter-opacity);
}

/* RmlUi ships no HTML user-agent stylesheet: everything defaults to
   display:inline. Give the common text elements their block flow here. */
h1, h2, h3, p, div {
	display: block;
}

h1 {
	font-size: 22px;
	font-weight: bold;
}

/* Old scheme fonts (SchemeBase.res "Fonts" section), 1080p tier in dp.
   Verdana covers latin glyphs; the YaHei fallback face covers CJK. */
.font-hudnum {
	font-family: Verdana;
	font-weight: bold;
	font-size: 14.25dp; /* "HealthBar"/"AmmoBar": 32px @1080p */
}
.font-default {
	font-family: Verdana;
	font-size: 8.9dp; /* "Default": 20px @1080p */
}
.font-defaultsmall {
	font-family: Verdana;
	font-size: 8.9dp; /* "DefaultSmall": 20px @1080p, weight 0 */
}
.font-textmenu {
	font-family: Verdana;
	font-size: 10.7dp; /* "TextMenu": 24px @1080p */
}
.font-uibold {
	font-family: Tahoma;
	font-weight: bold;
	font-size: 10dp; /* "UiBold": Tahoma tall 10 - the one scheme font with no
	    yres tiers, so vgui's proportional panels scaled it by screenH/480
	    (Scheme2 ReloadFontGlyphs) - 10 design units, not 10 screen px. */
}
