/* health.rcss - HealthPanel layout, HL2-inspired but not a copy: the vital
   readout is an amber icon plus one large amber number drawn straight on the
   scene (HL2 has no plate behind the vitals), while the vgui-era meter stays
   as the bar indicator under each value - the bar fill still animates by
   value/100 with the old 0.15s linear ramp.

   Geometry (design units, 1dp = one old proportional unit):
     health group  icon 0,4 20x20   number 26,0 78x28   meter 26,32 92x5
     armor group   icon 150,4 20x20 number 176,0 78x28  meter 176,32 92x5
     longjump icon 272,4 (visibility from the suit bit)
   The number box is 28 tall with a 28 line box, so the glyph band centres on
   the icon centre (4 + 10 = 14 = box centre). */

#health {
	position: absolute;
	left: 18dp;
	bottom: 12dp;
	width: 300dp;
	height: 46dp;
}

/* HL2-style vitals type: one big amber value per group. Verdana Bold stands
   in for the old CompactaBold; the 1px black outline is what keeps the number
   readable over bright floors (the additive glyph ink that replaced it read
   too flat once outlined, so the value went back to type). */
#health .font-vital {
	font-family: Verdana;
	font-weight: bold;
	font-size: 20dp;
	letter-spacing: 0.4dp;
	white-space: nowrap;
	font-effect: outline(1px #000000b4);
}

#health-icon, #armor-icon {
	position: absolute;
	top: 4dp;
	width: 20dp;
	height: 20dp;
	/* HUD accent (was scheme Default); applyDanger shifts the hue toward red
	   below hud_danger_health / hud_danger_armor. Additive texture. */
	image-color: var(--abc-hud-accent);
	opacity: var(--abc-hud-icon-opacity);
}
#health-icon { left: 0dp; }
#armor-icon { left: 150dp; }

#health-label, #armor-label {
	position: absolute;
	top: 0dp;
	width: 78dp;
	height: 28dp;
	text-align: left;
	/* vgui Labels centre their text vertically; Rml needs the explicit
	   line box (box height = one line). */
	line-height: 28dp;
	/* HUD accent; the danger rule overrides per value at runtime. */
	color: var(--abc-hud-accent);
	opacity: var(--abc-hud-value-opacity);
}
#health-label { left: 26dp; }
#armor-label { left: 176dp; }

/* Meter well: the black track behind the fill. */
#health-bar-bg, #armor-bar-bg {
	position: absolute;
	top: 32dp;
	width: 92dp;
	height: 5dp;
	background-color: var(--abc-hud-track);
	/* Pill: both ends rounded. */
	border-radius: 2.5dp;
}
#health-bar-bg { left: 26dp; }
#armor-bar-bg { left: 176dp; }

/* The fill is its own rounded bar (no clipping wrapper): its width is the
   value, so both ends stay round while it animates. */
#health-bar, #armor-bar {
	position: absolute;
	top: 32dp;
	width: 92dp;
	height: 5dp;
	background-color: var(--abc-hud-accent);
	border-radius: 2.5dp;
	opacity: var(--abc-hud-meter-opacity);
	transition: width 0.15s linear-in;
}
#health-bar { left: 26dp; }
#armor-bar { left: 176dp; }

#longjump {
	position: absolute;
	left: 272dp;
	top: 4dp;
	width: 20dp;
	height: 20dp;
	visibility: hidden;
	image-color: var(--abc-hud-accent);
	opacity: var(--abc-hud-icon-opacity);
}
