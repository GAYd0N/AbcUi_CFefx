/* ammobar.rcss - AmmoPanel layout, HL2-inspired but not a copy: per ammo type
   one "pool" line of ammo sprite + large clip value + small "/reserve", with
   the pools packed into the bottom-right corner and a thin amber rule
   between them. The old vgui plate is gone.

   Layout notes:
     - the body is the panel (100% x 100%) and a flex row with justify-end, so
       hiding a pool (display: none, set by AmmoBarPanel) closes the gap
       instead of leaving a hole at the right edge;
     - a pool is a single inline line, so the 24dp clip and the 13dp reserve
       share the font baseline exactly (RmlUi's flex baseline alignment is a
       0.5 * line-height heuristic - FlexFormattingContext - and cannot be
       used for this);
     - the ammo sprite is an inline image, so its bottom edge sits on the same
       baseline as the digits;
     - both pools have the same line-height, so their baselines also line up
       with each other across the divider. */

#ammobar {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	display: flex;
	flex-flow: row;
	justify-content: flex-end;
	align-items: flex-end;
	padding-right: 18dp;
	padding-bottom: 12dp;
}

/* One ammo type. Inline content inherits the big ammo type; the reserve span
   steps down without leaving the baseline. */
#ammobar .pool {
	display: block;
	white-space: nowrap;
	font-family: Verdana;
	font-weight: bold;
	font-size: 24dp;
	letter-spacing: 0.3dp;
	line-height: 26dp;
	color: var(--abc-hud-accent);
	/* Type again, with the 1px black outline that keeps the clip readable over
	   the weapon and bright floors. */
	font-effect: outline(1px #000000b4);
	opacity: var(--abc-hud-value-opacity);
}

#ammobar .pool .icon {
	width: 20dp;
	height: 20dp;
	margin-right: 7dp;
	/* Old AmmoBar.Ammo1/2IconColor = HUD accent. */
	image-color: var(--abc-hud-accent);
	/* Per-element opacity, not a group: the sprite sits at icon opacity even
	   inside the value-opacity pool. */
	opacity: var(--abc-hud-icon-opacity);
}

/* HL2-style reserve: a step smaller, dimmer, still on the clip baseline. */
#ammobar .pool .reserve {
	font-weight: normal;
	font-size: 13dp;
	letter-spacing: 0dp;
	margin-left: 2dp;
	color: var(--abc-hud-accent-dim);
	font-effect: outline(1px #000000b4);
}

/* Pool divider: the old red "|" glyph becomes a flat amber hairline. It is
   exactly as tall as the ammo sprite and its bottom sits on the shared
   baseline (8dp is the line box below the baseline at 24dp type, see the
   probe), so it reads as a separator instead of a box edge. */
#ammobar #pool-sep {
	width: 1dp;
	height: 20dp;
	margin-left: 12dp;
	margin-right: 12dp;
	margin-bottom: 8dp;
	align-self: flex-end;
	background-color: var(--abc-hud-accent-faint);
	opacity: var(--abc-hud-meter-opacity);
}
