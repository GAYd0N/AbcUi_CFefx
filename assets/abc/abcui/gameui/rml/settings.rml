<rml>
<head>
	<link type="text/rcss" href="../../rcss/base.rcss"/>
	<link type="text/rcss" href="../../rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/settings.rcss"/>
	<link type="text/rcss" href="../rcss/range.rcss"/>
</head>
<!-- The configuration document. JSON owns page identities, labels, the
     section cards, their widgets and their rows; this document carries only
     the navigation/content hosts, the movable special widgets, the global
     action bar and the confirmation layers.

     A page is a list of section cards (one big row per declared section).
     Each widget block below is a singleton: when the active page declares its
     component, the page projection moves the block into that section's card
     (services::uiconfig::SectionDefinition::components); otherwise the block
     waits in #settings-widget-host, which is hidden in configured runs. -->
<body id="menusettings">
	<div id="settings-navigation"></div>
	<div id="panel">
		<div id="settings-head">
			<div id="settings-brand">Sven Co-op</div>
			<h1 id="title">#Settings_Title</h1>
		</div>
		<div id="settings-status"></div>
		<p id="settings-description"></p>
		<!-- Section cards are injected here by SettingsPage::buildRows(). -->
		<div id="rows"></div>
		<!-- Widget parking: visible only for the legacy all-in-one projection
		     (no page definitions), hidden for configured runs. -->
		<div id="settings-widget-host">
			<div class="settings-widget" id="widget-model-preview">
				<!-- The player model preview is a live Studio render (font/HLP
				     style inspection): drag it with the primary button to turn
				     the character. -->
				<div class="preview-box">
					<model id="model-preview" auto-frame="true" frame-margin="1.25" drag-rotate="true"
						sequence="2" animate="true" angles="0 25 0"
				controllers="127 127 127 127" blending="127 127"
						camera-origin="120 0 0" camera-angles="0 180 0" fov="40"
						ambient="96" shade="110" light-color="1 0.96 0.9" light-direction="-0.6 -0.35 -1"/>
					<div id="model-preview-hint">#Settings_PlayerModelHint</div>
				</div>
			</div>
			<div class="settings-widget" id="widget-model-picker">
				<!-- I16 model picker: the models/player list with favorites and
				     text filtering (legacy ABCEnchance parity). Rows are
				     injected by sections::ModelPicker; a click selects and
				     writes the `model` cvar (the preview follows), the star
				     toggles the favorite. The section renderer keeps the
				     current engine model selected. -->
				<div id="model-picker">
					<div class="model-picker-label">#Settings_ModelFilter</div>
					<input class="row-input model-picker-filter" id="model-picker-filter" type="text"/>
					<button class="row-toggle model-picker-favonly" id="model-picker-favonly" data-action="model-picker-favonly">#Settings_ModelFavOnly</button>
					<div id="model-picker-list"></div>
					<div id="model-picker-status"></div>
				</div>
			</div>
			<div class="settings-widget" id="widget-spray-preview">
				<div class="preview-box">
					<img id="spray-preview"/>
					<div id="spray-preview-hint">#Settings_SprayPreviewHint</div>
				</div>
			</div>
			<div class="settings-widget" id="widget-spray-maker">
				<!-- Spray maker: pick an image anywhere on disk, the module
				     decodes it (FreeImage), encodes the WAD3 spray and writes
				     tempdecal.wad; this block shows the result preview and
				     the outcome line. -->
				<div class="preview-box">
					<img id="spray-made-preview"/>
					<div id="spray-maker-hint">#Settings_SprayMakerHintTitle</div>
					<button id="spray-maker-choose" data-action="spray-choose">#Settings_SprayMakerChoose</button>
					<div id="spray-maker-status"></div>
				</div>
			</div>
			<div class="settings-widget" id="widget-crosshair-preview">
				<!-- The same five core bars + five outline bars the in-game
				     crosshair panel draws, laid out by the shared
				     services::crosshair::Geometry math from the draft cvar
				     values (1:1 pixel geometry, no drift - the preview shows
				     the configured shape, not the aim spread). -->
				<div class="preview-box">
					<div id="crosshair-preview">
						<div id="cx-outline-center" class="cx-outline"></div>
						<div id="cx-outline-top" class="cx-outline"></div>
						<div id="cx-outline-bottom" class="cx-outline"></div>
						<div id="cx-outline-left" class="cx-outline"></div>
						<div id="cx-outline-right" class="cx-outline"></div>
						<div id="cx-core-center" class="cx-core"></div>
						<div id="cx-core-top" class="cx-core"></div>
						<div id="cx-core-bottom" class="cx-core"></div>
						<div id="cx-core-left" class="cx-core"></div>
						<div id="cx-core-right" class="cx-core"></div>
					</div>
					<div id="crosshair-preview-hint">#Settings_CrosshairPreviewHint</div>
				</div>
			</div>
			<div class="settings-widget" id="widget-crosshair-color">
				<!-- RGBA pickers: one element per colour edits all four channels
				     (the eight per-channel rows stay declared in JSON as the
				     transaction backbone but are not drawn as sliders). The
				     widget stacks under the preview in the same column. -->
				<div class="color-row">
					<div class="row-label">#Settings_CrosshairColor</div>
					<colorpicker id="crosshair-color" value="#32fa32c8"/>
				</div>
				<div class="color-row">
					<div class="row-label">#Settings_CrosshairOutlineColor</div>
					<colorpicker id="crosshair-outline-color" value="#000000ff"/>
				</div>
			</div>
			<div class="settings-widget" id="widget-bindings">
				<div id="bind-status"></div>
				<div id="bindrows"></div>
			</div>
			<div class="settings-widget" id="widget-video">
				<div id="video-section">
					<div class="row" id="video-row-resolution">
						<div class="row-label">#Settings_VideoResolution</div>
						<select class="video-select" id="video-resolution"></select>
					</div>
					<div class="row" id="video-row-windowed">
						<div class="row-label">#Settings_VideoWindowed</div>
						<button class="row-toggle" id="video-windowed" data-action="video-toggle-windowed"></button>
					</div>
					<div id="video-status"></div>
					<div id="video-actions">
						<button id="video-apply" data-action="video-apply" data-label="#Settings_VideoApply">#Settings_VideoApply</button>
					</div>
				</div>
			</div>
			<div class="settings-widget" id="widget-voice">
				<!-- T13 voice section: the voice cvar rows (voice_scale /
				     voice_modenable) ride the section card's rows; these are
				     the IVoiceTweak hardware rows. The ids are page contracts;
				     the whole section fail-closes when the engine interface is
				     missing. -->
				<div id="voice-section">
					<div class="row" id="voice-row-volume">
						<div class="row-label">#Settings_MicVolume</div>
						<input class="row-input row-slider" type="range" min="0" max="100" step="1" id="voice-mic-volume"/>
						<span id="voice-mic-value" class="row-value"></span>
					</div>
					<div class="row" id="voice-row-boost">
						<div class="row-label">#Settings_MicBoost</div>
						<button class="row-toggle" id="voice-mic-boost" data-action="voice-mic-boost"></button>
					</div>
					<div class="row" id="voice-row-test">
						<div class="row-label">#Settings_MicTest</div>
						<button class="row-toggle" id="voice-mic-test" data-action="voice-test"></button>
					</div>
					<div id="voice-status"></div>
					<div id="voice-meter" aria-label="#Settings_MicLevel"><div id="voice-meter-fill"></div></div>
				</div>
			</div>
		</div>
	</div>
	<div id="settings-actions">
		<button id="settings-apply" data-action="apply" data-label="#Settings_Apply" autofocus="autofocus">#Settings_Apply</button>
		<button id="settings-return" data-action="return" data-label="#MainMenu_Return">#MainMenu_Return</button>
		<button id="settings-reset" data-action="reset-defaults" data-label="#Settings_ResetDefaults">#Settings_ResetDefaults</button>
		<!-- The key-binding defaults entry rides the same row: it is only
		     visible on the keyboard page, where the page defaults entry is
		     absent, so the row never shows two destructive entries. -->
		<button id="bind-reset" data-action="bind-reset-defaults" data-label="#Settings_BindResetDefaults">#Settings_BindResetDefaults</button>
	</div>
	<!-- Page-internal layers live OUTSIDE the scrollable panel: they
	     anchor to the document and stay viewport-covering no matter how
	     far the rows are scrolled (absolute layers inside the scroll
	     container scroll out of the visible area - live-caught). -->
	<div id="reset-confirm" class="settings-layer">
		<h1 class="settings-layer-title">#Settings_ResetConfirmTitle</h1>
		<p id="reset-confirm-text">#Settings_ResetConfirm</p>
		<button id="reset-yes" data-action="reset-yes" data-label="#Settings_ResetYes">#Settings_ResetYes</button>
		<button id="reset-no" data-action="reset-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
	</div>
	<div id="leave-confirm" class="settings-layer">
		<h1 class="settings-layer-title">#Settings_UnsavedConfirmTitle</h1>
		<p id="leave-confirm-text">#Settings_UnsavedConfirm</p>
		<button id="leave-discard" data-action="leave-discard" data-label="#Settings_DiscardReturn">#Settings_DiscardReturn</button>
		<button id="leave-stay" data-action="leave-stay" data-label="#Settings_Stay" autofocus="autofocus">#Settings_Stay</button>
	</div>
	<div id="bind-conflict" class="settings-layer">
		<h1 class="settings-layer-title">#Settings_BindConflictTitle</h1>
		<p id="bind-conflict-text"></p>
		<button id="bind-conflict-yes" data-action="bind-conflict-yes" data-label="#Settings_BindConflictYes">#Settings_BindConflictYes</button>
		<button id="bind-conflict-no" data-action="bind-conflict-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
	</div>
	<div id="bind-reset-confirm" class="settings-layer">
		<h1 class="settings-layer-title">#Settings_BindResetConfirmTitle</h1>
		<p id="bind-reset-confirm-text">#Settings_BindResetConfirm</p>
		<button id="bind-reset-yes" data-action="bind-reset-yes" data-label="#Settings_ResetYes">#Settings_ResetYes</button>
		<button id="bind-reset-no" data-action="bind-reset-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
	</div>
	<!-- The spray picker: a wider prompt holding the directory model's view -
	     quick roots, the current path, the entry list and the actions. Rows
	     are injected by sections::SpraySection; a click selects, confirm
	     starts the maker. -->
	<div id="spray-file" class="settings-layer settings-layer-wide">
		<h1 class="settings-layer-title">#Settings_SprayMakerTitle</h1>
		<div id="spray-file-roots"></div>
		<div id="spray-file-path"></div>
		<div id="spray-file-list"></div>
		<div id="spray-file-status"></div>
		<div id="spray-file-actions">
			<button id="spray-file-confirm" data-action="spray-file-confirm">#Settings_SprayMakerMake</button>
			<button id="spray-file-up" data-action="spray-file-up">#Settings_SprayMakerUp</button>
			<button id="spray-file-cancel" data-action="spray-file-cancel" autofocus="autofocus">#Settings_Cancel</button>
		</div>
	</div>
	<!-- I16 model picker favorite menu: opened by right-click on a picker
	     row, anchored to the pointer like the console's copy menu (outside
	     the scroll container, so it never scrolls away with the rows). -->
	<div id="model-picker-context-menu">
		<div id="model-picker-context-fav" class="model-picker-context-item" data-action="model-picker-context-fav"></div>
	</div>
</body>
</rml>
