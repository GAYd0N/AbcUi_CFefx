/* settings.rcss - the configuration page, on the shared main-menu theme.

   Layout rules (read them before touching a width):

   * The page keeps its two verified halves: the page navigation column on the
     left and one scrollable panel on the right. The panel is the ONLY scroll
     container - a nested scroller inside it clipped its whole content on the
     live build.
   * The logical screen is 640x480dp at minimum (the context density ratio
     scales it), so the panel is 452dp wide at the narrowest and every width
     below is explicit dp. Percentages inside a scroll container collapse on
     this engine (recorded trap).
   * A page is a list of section cards. A card that carries a widget (model /
     spray / crosshair preview, the bind list, the video and voice blocks)
     floats the widget to the right at 150dp and lays its rows out in the
     232dp column that remains; a card without widgets uses the full 392dp.
   * Text below 9dp does not render on this engine (filled black glyphs -
     live-measured 2026-10-15), so 9dp is the floor for every label, value and
     button; 8dp survives only on the muted status lines the other pages
     already use.

   The document links range.rcss AFTER this file, so range-control overrides
   need the extra `.settings-card` qualifier to win. */

/* ---- page frame ---------------------------------------------------------- */

body#menusettings #panel {
	box-sizing: border-box;
	left: 156dp;
	right: 32dp;
	width: auto;
	top: 40dp;
	height: 356dp;
	padding-right: 22dp;
	overflow: auto;
}

#settings-head {
	display: block;
	height: 46dp;
	margin-bottom: 4dp;
}

#settings-brand {
	display: block;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	margin-bottom: 4dp;
}

/* The shared mainmenu headline, with a tighter line box so the brand line
   above it cannot collide with tall CJK glyphs. */
#settings-head #title {
	line-height: 22dp;
}

/* #title is the shared mainmenu headline (18dp strong). */
#settings-status {
	display: block;
	font-size: 9dp;
	color: var(--abc-text-dim);
	min-height: 14dp;
	line-height: 14dp;
}

#settings-description {
	display: block;
	font-size: 9dp;
	color: var(--abc-text-dim);
	margin: 4dp 0dp 8dp 0dp;
}

/* ---- page navigation ----------------------------------------------------- */

#settings-navigation {
	position: absolute;
	left: 16dp;
	top: 40dp;
	width: 128dp;
	height: 356dp;
	overflow: auto;
}

#settings-navigation button {
	display: block;
	box-sizing: border-box;
	width: 122dp;
	height: 28dp;
	line-height: 26dp;
	text-align: left;
	padding-left: 10dp;
	margin: 0dp 0dp 3dp 0dp;
	background-color: #111920cc;
	border-left: 2dp var(--abc-line);
	border-top: 1dp var(--abc-line-soft);
	color: var(--abc-text);
	font-size: 9dp;
	letter-spacing: 0.4dp;
	tab-index: auto;
}

#settings-navigation button:hover {
	background-color: #1b252bf2;
	color: var(--abc-text-strong);
}

#settings-navigation button.selected,
#settings-navigation button:focus {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent);
}

/* RmlUi builds its scrollbar elements without any user-agent styles: they
   need explicit layout or the unstyled sliderbar overlays the content and
   swallows every click (live-caught: the bind buttons were unreachable).
   The sample pattern: a zero-width positioned container whose thin bar
   juts out to the left with negative margin. */
body#menusettings #panel scrollbarvertical,
#settings-navigation scrollbarvertical {
	z-index: 100;
	width: 0dp;
}
body#menusettings #panel scrollbarvertical sliderbar,
#settings-navigation scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: var(--abc-line);
}
body#menusettings #panel scrollbarvertical sliderbar:hover,
body#menusettings #panel scrollbarvertical sliderbar:active,
#settings-navigation scrollbarvertical sliderbar:hover,
#settings-navigation scrollbarvertical sliderbar:active {
	background-color: #55606c;
}

/* ---- section cards ------------------------------------------------------- */

#rows {
	display: block;
	width: auto;
}

.settings-card {
	display: block;
	box-sizing: border-box;
	background-color: var(--abc-surface-2);
	border: 1dp var(--abc-line);
	padding: 10dp;
	margin-bottom: 10dp;
}

/* Card headline: the theme's section type (amber, uppercase, letter-spaced)
   over a hairline that separates it from the card body. */
.settings-card-title {
	display: block;
	font-size: 9dp;
	font-weight: bold;
	letter-spacing: 1.6dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	border-bottom: 1dp var(--abc-line-soft);
	padding-bottom: 5dp;
	margin-bottom: 8dp;
}

.settings-card-items {
	display: block;
}

/* Preview column: the previews live in the right half of the card, in the
   space the 232dp row column leaves. The body is one flex row so the preview
   column takes exactly the remaining width (a fixed 150dp float left dead
   space beside the rows - live-caught) and its items stretch to the row
   column's height. Two previews in one card (classic + custom spray) share
   the column in one row. */
.settings-card-body {
	display: block;
}

.settings-card.has-preview .settings-card-body {
	display: flex;
	align-items: stretch;
}

.settings-card.has-preview .settings-card-items {
	flex: 0 0 232dp;
	width: 232dp;
}

.settings-card.has-preview .settings-card-widgets {
	display: flex;
	flex-direction: row;
	align-items: stretch;
	flex: 1 1 0%;
	min-width: 0dp;
	margin-left: 12dp;
}

.settings-card.has-preview .settings-card-widgets .settings-widget {
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0dp;
}

/* Full-width widget blocks (bind list, display modes, microphone hardware)
   render above the rows; the rows keep the card's full width. */
.settings-card.has-block .settings-card-widgets {
	display: block;
	margin-bottom: 8dp;
}

/* Preview card with a second widget (the crosshair RGBA pickers): both
   widgets share the preview column, stacked - the preview keeps the
   remaining height above the pickers instead of the pickers sitting beside
   it in the row. */
.settings-card.has-preview.has-side-stack .settings-card-widgets {
	display: flex;
	flex-direction: column;
	align-items: stretch;
}
.settings-card.has-preview.has-side-stack .settings-card-widgets .settings-widget {
	flex: 0 0 auto;
}
.settings-card.has-preview.has-side-stack #widget-crosshair-preview {
	flex: 1 1 auto;
	min-height: 150dp;
}

/* Two-up section (the crosshair card): the widget band spans the card above
   a two-column row grid. The preview and the RGBA pickers share the band, so
   the preview is a compact fixed window instead of a full-height column, and
   pairing the rows halves the card height. */
.settings-card.layout-two-up .settings-card-widgets {
	display: flex;
	flex-direction: row;
	align-items: stretch;
	margin-bottom: 10dp;
}
.settings-card.layout-two-up .settings-card-widgets .settings-widget {
	display: flex;
	flex-direction: column;
	min-width: 0dp;
}
.settings-card.layout-two-up #widget-crosshair-preview {
	flex: 0 0 220dp;
	width: 220dp;
}
.settings-card.layout-two-up #widget-crosshair-color {
	flex: 1 1 0%;
	margin: 0dp 0dp 0dp 12dp;
}
.settings-card.layout-two-up .row-pair {
	display: flex;
	align-items: flex-start;
}
.settings-card.layout-two-up .row-pair .row {
	flex: 1 1 0%;
	min-width: 0dp;
	margin-right: 8dp;
}
.settings-card.layout-two-up .row-pair .row:last-child {
	margin-right: 0dp;
}
.settings-card.layout-two-up .row-input,
.settings-card.layout-two-up .row-select {
	width: 100%;
}
/* The value readout takes 46dp of the paired row; a 150dp slider plus the
   readout still fits the narrowest 640x480 card. */
.settings-card.layout-two-up input.row-slider {
	width: 150dp;
}

/* ---- rows ---------------------------------------------------------------- */

.row {
	display: block;
	margin-bottom: 9dp;
}

.row-label {
	display: block;
	font-size: 9dp;
	color: var(--abc-text);
	margin-bottom: 3dp;
}

.row-input,
.row-select {
	display: inline-block;
	box-sizing: border-box;
	width: 372dp;
	height: 24dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	font-size: 9dp;
	padding: 0dp 6dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
	white-space: nowrap;
}

.settings-card.has-preview .row-input,
.settings-card.has-preview .row-select {
	width: 220dp;
}

.row-input:focus,
.row-select:focus {
	border: 1dp var(--abc-accent);
	background-color: #0e1418;
}

.row-input caret {
	display: inline-block;
	background-color: #e8e8e8;
}

.settings-card input.row-slider {
	width: 300dp;
}

.settings-card.has-preview input.row-slider {
	width: 164dp;
}

.settings-card .row-value {
	width: 46dp;
	font-size: 9dp;
	color: var(--abc-text);
	text-align: right;
	height: 24dp;
	line-height: 24dp;
	vertical-align: top;
}

.row-toggle {
	display: inline-block;
	width: auto;
	min-width: 64dp;
	height: 24dp;
	line-height: 22dp;
	text-align: center;
	background-color: var(--abc-surface-2);
	color: var(--abc-text);
	font-size: 9dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
}

.row-toggle:hover {
	background-color: var(--abc-surface-3);
}

.row-toggle:focus {
	background-color: var(--abc-accent);
	border: 1dp var(--abc-accent);
	color: var(--abc-accent-ink);
}

.row-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 2dp;
}

/* Unavailable rows (cvar not registered): greyed, still readable. */
.row-missing {
	color: #6a7178;
	opacity: 0.6;
}

.row-readonly,
input:disabled {
	opacity: 0.55;
}

/* ---- bindings widget ----------------------------------------------------- */

#bind-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	min-height: 12dp;
	line-height: 12dp;
	margin-bottom: 4dp;
}

#bindrows {
	display: block;
}

.bind-header {
	display: block;
	background-color: var(--abc-surface-3);
	padding: 4dp 5dp;
	margin: 8dp 0dp 6dp 0dp;
	color: var(--abc-accent);
	font-size: 9dp;
	letter-spacing: 0.8dp;
	text-transform: uppercase;
}

.bind-header-columns {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
}

.bind-row {
	display: block;
	margin-bottom: 3dp;
}

.bind-line {
	display: block;
	height: 24dp;
	line-height: 24dp;
	white-space: nowrap;
	overflow: hidden;
}

.bind-label {
	display: inline-block;
	width: 150dp;
	font-size: 9dp;
	color: var(--abc-text);
	vertical-align: middle;
	white-space: nowrap;
	overflow: hidden; /* long labels clip, never bleed into the key column */
}

.bind-keys {
	display: inline-block;
	width: 80dp;
	font-size: 9dp;
	color: var(--abc-ok);
	vertical-align: middle;
	white-space: nowrap;
}

.bind-row.bind-capturing .bind-keys {
	color: var(--abc-warn);
}

.bind-btn {
	display: inline-block;
	width: auto;
	min-width: 46dp;
	height: 22dp;
	line-height: 20dp;
	text-align: center;
	background-color: var(--abc-surface-2);
	color: var(--abc-text);
	font-size: 9dp;
	border: 1dp var(--abc-line);
	margin: 0dp 0dp 0dp 3dp; /* the theme button margin would stack here */
	vertical-align: middle;
	tab-index: auto;
	white-space: nowrap;
}

.bind-btn:hover {
	background-color: var(--abc-surface-3);
}

.bind-btn:focus {
	background-color: var(--abc-accent);
	border: 1dp var(--abc-accent);
	color: var(--abc-accent-ink);
}

.bind-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-left: 150dp;
}

/* ---- video widget -------------------------------------------------------- */

/* A projection of the video model; when the query interface is missing the
   block renders disabled (video-unavailable) instead of pretending controls
   work. */
#video-section {
	display: block;
}

#video-section .video-select {
	display: inline-block;
	width: 220dp;
}

#video-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 4dp;
}

#video-actions {
	display: block;
	margin-top: 8dp;
}

#video-section.video-unavailable #video-status {
	color: var(--abc-warn);
}

#video-apply.video-disabled {
	color: #6f757c;
	border-color: #3a4047;
}

/* ---- voice widget -------------------------------------------------------- */

#voice-section {
	display: block;
}

#voice-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 4dp;
}

#voice-section.video-unavailable #voice-status {
	color: var(--abc-warn);
}

#voice-meter {
	display: block;
	width: 150dp;
	height: 14dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	margin: 8dp 0dp;
}

#voice-meter-fill {
	display: block;
	width: 0%;
	height: 14dp;
	background-color: var(--abc-ok);
}

/* ---- preview widgets ----------------------------------------------------- */

.settings-widget {
	display: block;
}

.preview-box {
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	width: 100%;
	min-height: 0dp;
}

.preview-box img {
	display: block;
	width: 100%;
	height: auto;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
}

/* The player model preview fills its whole cell: the live FBO re-renders at
   the box's size, so it grows with the card instead of sitting in a 150dp
   slot with dead space beside it. The min-height keeps a real viewport even
   when the row column is short (RmlUi's flex does not reliably propagate a
   stretched column height down to an auto-height custom element). */
#model-preview {
	display: block;
	flex: 1 1 auto;
	width: 100%;
	height: auto;
	min-height: 300dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	cursor: move;
}

#model-preview-hint,
#spray-preview-hint,
#crosshair-preview-hint {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 3dp;
}

/* Crosshair preview: a fixed 150dp window on the dark inset; the parts are
   absolutely positioned around the box centre by the projection (percent
   anchoring + a translate in raw px keeps the geometry independent of the
   density ratio, exactly like the in-game panel's pixel values). Parts that
   are switched off keep the transparent colour. */
#crosshair-preview {
	position: relative;
	display: block;
	box-sizing: border-box;
	flex: 1 1 auto;
	width: 100%;
	min-height: 0dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	overflow: hidden;
}

#crosshair-preview .cx-core,
#crosshair-preview .cx-outline {
	position: absolute;
	left: 50%;
	top: 50%;
	background-color: rgba(0, 0, 0, 0);
}

/* ---- crosshair RGBA picker widget --------------------------------------- */

/* One picker per colour, stacked under the preview. The element paints the
   hue strip, the saturation/value square and the alpha strip itself; the
   box only supplies the size and the inset frame. */
#widget-crosshair-color {
	display: block;
	margin-top: 8dp;
}

.color-row {
	display: block;
	margin-bottom: 9dp;
}

.color-row .row-label {
	margin-bottom: 3dp;
}

colorpicker {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 64dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
}

/* ---- spray maker --------------------------------------------------------- */

/* The made spray keeps its own aspect: the encoded spray is capped at 256
   pixels and 16-aligned, so a wide source stays wide. */
#spray-made-preview {
	display: block;
	width: 100%;
	height: auto;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	image-color: #ffffffff; /* the made spray shows its own colours 1:1 */
}

#spray-maker-hint {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 3dp;
}

#spray-maker-choose {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 24dp;
	margin: 6dp 0dp 0dp 0dp;
}

#spray-maker-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	margin-top: 4dp;
}

/* ---- spray picker layer -------------------------------------------------- */

/* Wider and taller than the confirmation prompts: the list needs the room (a
   roots row, a breadcrumb path, a bounded scrolling list, the actions row).
   The prompt's centred top/bottom-50vh trick sizes a box to its min-height and
   lets the content spill past it (live-caught: the action row landed below the
   viewport), so the picker anchors to the top and grows with its content. */
/* Specificity note: this block precedes .settings-layer in the file, so the
   two-class selector keeps the overrides (top/height behaviour) winning. */
.settings-layer.settings-layer-wide {
	width: 520dp;
	margin-left: -261dp;
	top: 20dp;
	bottom: auto;
	margin-top: 0dp;
	margin-bottom: 0dp;
	transform: none;
}

#spray-file-roots {
	display: block;
	margin-bottom: 6dp;
}

#spray-file-roots button.spray-file-root {
	display: inline-block;
	width: auto;
	min-width: 0dp;
	height: 22dp;
	line-height: 20dp;
	margin: 0dp 4dp 4dp 0dp;
	padding-left: 8dp;
	padding-right: 8dp;
	font-size: 9dp;
}

#spray-file-path {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 22dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	color: var(--abc-text);
	font-size: 9dp;
	padding: 0dp 6dp;
	white-space: nowrap;
	overflow: hidden;
	margin-bottom: 6dp;
}

/* The only scroller inside the layer: a bounded window on the entry list
   (the layer itself must not grow past the viewport). */
#spray-file-list {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 220dp;
	overflow-y: auto;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
}

.spray-file-row {
	display: block;
	height: 22dp;
	line-height: 22dp;
	padding: 0dp 8dp;
	color: var(--abc-text);
	font-size: 9dp;
	white-space: nowrap;
	overflow: hidden;
}

.spray-file-row:hover {
	background-color: var(--abc-surface-3);
}

.spray-file-row.selected {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-text-strong);
}

.spray-file-name {
	display: inline-block;
	width: 380dp;
	overflow: hidden;
}

.spray-file-tag {
	display: inline-block;
	width: 100dp;
	color: var(--abc-text-dim);
	font-size: 8dp;
	text-transform: uppercase;
	letter-spacing: 1dp;
}

.spray-file-empty {
	display: block;
	height: 22dp;
	line-height: 22dp;
	padding: 0dp 8dp;
	color: var(--abc-text-dim);
	font-size: 9dp;
}

#spray-file-list scrollbarvertical {
	z-index: 100;
	width: 0dp;
}

#spray-file-list scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: var(--abc-line);
}

#spray-file-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	height: 14dp;
	line-height: 14dp;
	margin-top: 6dp;
}

#spray-file-actions {
	display: block;
	margin-top: 8dp;
}

/* The widget parking space: invisible in configured runs (the projection
   moves the claimed blocks into their cards), a plain stack for the legacy
   all-in-one projection that carries no page definitions. */
#settings-widget-host {
	display: none;
}

/* ---- action bar ---------------------------------------------------------- */

/* One flat row: Apply, Return and the page's default-reset entry share the
   bar (the key-binding reset joins them on the keyboard page, where the
   page entry is hidden). A flex line distributes them equally and never
   wraps, so no column can push Return below the viewport. The bar keeps
   the panel's left anchor and stretches to the same 32dp right gutter,
   and anchors to the bottom gutter so the footer holds its 48dp margin
   when a narrower window raises the logical viewport height. */
#settings-actions {
	display: flex;
	position: absolute;
	left: 156dp;
	right: 32dp;
	bottom: 48dp;
	width: auto;
	height: 28dp;
	z-index: 1;
}

#settings-actions button {
	display: block;
	box-sizing: border-box;
	flex: 1 1 0%;
	min-width: 0dp;
	width: auto;
	height: 28dp;
	margin: 0dp 0dp 0dp 10dp;
	white-space: nowrap;
	overflow: hidden;
}

#settings-actions button:first-child {
	margin-left: 0dp;
}

/* The defaults entries preview their destructive effect on hover. Focus
   keeps the shared amber treatment (the theme sheet's :focus rule wins on
   hover-click). */
#settings-reset:hover,
#bind-reset:hover {
	background-color: #3a1c1c;
	border-color: var(--abc-danger);
	color: var(--abc-danger);
}

/* ---- page-internal confirm layers ---------------------------------------- */

/* Document-level overlays (direct children of the body, NOT of the
   scrollable panel - absolute layers inside the scroll container scroll away
   with the content). Hidden until the page turns the display property on
   (the layer member tracks the state - a SetProperty lands at the next
   layout frame).

   Every prompt copies the quit confirmation's frame - the #panel surface
   with its hairline border and amber top rule, a 372dp content box, 16dp
   padding, a 16dp amber headline and a left-aligned body/button column - so
   the settings prompts read exactly like the one the player sees when
   quitting. The 50vw columns and the 50vh rows plus the auto margins pin the
   box to the exact viewport centre whatever its height, and the -5dp
   margin-top lifts the default position above that centre. The layer rides
   above the action bar (z-index 1). */
.settings-layer {
	box-sizing: border-box;
	display: none;
	position: absolute;
	z-index: 2;
	left: 50vw;
	margin-left: -187dp; /* half of the 372dp box + the 1dp border */
	top: 50vh;
	bottom: 50vh;
	margin-top: auto; /* centre, then the lift below pulls the default up 5dp */
	margin-bottom: auto;
	transform: translateY(-5dp);
	width: 372dp; /* the panel width the prompt interrupts */
	min-height: 128dp;
	background-color: #101418f8;
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
	padding: 16dp;
}

.settings-layer-title {
	display: block;
	font-size: 16dp;
	font-weight: bold;
	color: var(--abc-accent);
	margin: 0dp 0dp 12dp 0dp;
}

.settings-layer p {
	display: block;
	font-size: 10dp;
	color: var(--abc-text);
	margin-top: 0dp;
	margin-bottom: 12dp;
}

.settings-layer button {
	display: inline-block;
	width: auto;
	margin: 0dp 0dp 0dp 8dp;
}

.settings-layer button:first-child {
	margin-left: 0dp;
}

/* ---- I16 model picker ---------------------------------------------------- */

/* The player-model list widget (favorites + text filtering). It shares the
   preview card's right column with the live <model> preview and mirrors the
   spray picker's list styling. */
#model-picker {
	display: block;
	margin-top: 6dp;
}

#model-picker-filter {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 22dp;
	line-height: 20dp;
	margin-bottom: 4dp;
	font-size: 9dp;
}

#model-picker-favonly {
	display: inline-block;
	width: auto;
	min-width: 0dp;
	height: 20dp;
	line-height: 18dp;
	margin: 0dp 0dp 4dp 0dp;
	padding: 0dp 8dp;
	font-size: 8dp;
}

#model-picker-favonly.on {
	background-color: var(--abc-accent);
	border: 1dp var(--abc-accent);
	color: var(--abc-accent-ink);
}

#model-picker-list {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 180dp;
	overflow-y: auto;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
}

.model-picker-row {
	display: block;
	width: auto;
	min-width: 0dp;
	height: 22dp;
	line-height: 20dp;
	margin: 0dp;
	padding: 0dp 6dp;
	background-color: transparent;
	border: 0dp;
	border-left: 2dp transparent;
	color: var(--abc-text);
	font-size: 9dp;
	text-align: left;
	white-space: nowrap;
	overflow: hidden;
}

.model-picker-row:hover,
.model-picker-row:focus {
	background-color: var(--abc-surface-3);
	border: 0dp;
	border-left: 2dp transparent;
	color: var(--abc-text);
}

.model-picker-row.selected {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-text-strong);
}

.model-picker-name {
	display: inline-block;
	width: auto;
	overflow: hidden;
}

/* The favorite mark rides every row (dimmed until toggled) and carries its
   own action, so the click never selects the row underneath it. */
.model-picker-star {
	display: inline-block;
	float: right;
	height: 20dp;
	line-height: 20dp;
	min-width: 0dp;
	padding: 0dp 2dp 0dp 8dp;
	background-color: transparent;
	border: 0dp;
	color: var(--abc-text-dim);
	font-size: 8dp;
}

.model-picker-star.on {
	color: var(--abc-accent);
}

.model-picker-empty {
	display: block;
	height: 22dp;
	line-height: 22dp;
	padding: 0dp 8dp;
	color: var(--abc-text-dim);
	font-size: 9dp;
}

#model-picker-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	height: 14dp;
	line-height: 14dp;
	margin-top: 4dp;
}

#model-picker-list scrollbarvertical {
	z-index: 100;
	width: 0dp;
}

#model-picker-list scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: var(--abc-line);
}

.model-picker-label {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 2dp;
}

/* The picker's right-click favorite menu: the console copy menu's recipe -
   an absolutely positioned frame clamped to the viewport, sized by these
   fixed dp (the opener clamps with the same numbers). */
#model-picker-context-menu {
	position: absolute;
	display: none;
	z-index: 20;
	min-width: 96dp;
	padding: 2dp;
	background-color: #181d22f8;
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
}

.model-picker-context-item {
	display: block;
	height: 20dp;
	line-height: 20dp;
	padding-left: 8dp;
	padding-right: 8dp;
	font-size: 9dp;
	color: var(--abc-text);
}

.model-picker-context-item:hover {
	background-color: var(--abc-accent);
	color: var(--abc-accent-ink);
}
